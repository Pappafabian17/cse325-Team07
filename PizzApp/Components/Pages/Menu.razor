@page "/menu"
@using Microsoft.EntityFrameworkCore
@using PizzApp.Data
@using PizzApp.Models
@using PizzApp.Services
@inject IDbContextFactory<PizzAppDbContext> DbFactory
@inject CartService CartService
@inject NavigationManager Navigation

<PageTitle>Menu - PizzApp</PageTitle>

<div class="container-xl py-4 py-md-5">
    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-5 pb-3 border-bottom">
        <div>
            <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-semibold mb-2">
                🍕 Handcrafted Daily
            </span>
            <h1 class="display-5 fw-bold mb-1">Our Specialty Pizzas</h1>
            <p class="text-muted mb-0">Crafted with hand-tossed dough, rich tomato sauce, and 100% whole milk mozzarella.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success-subtle text-success fs-6 px-3 py-2 rounded-pill">
                <i class="bi bi-fire me-1"></i> Hot & Fresh from the Oven
            </span>
        </div>
    </div>

    <!-- Build Your Own Pizza -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5 build-your-own-card">
        <div class="row g-0 align-items-center">

            <div class="col-12 col-md-4 text-center p-4 bg-light">
                <img src="/images/builder/base-cheese.png"
                    alt="Build your own pizza"
                    class="img-fluid"
                    style="max-height: 220px; object-fit: contain;" />
            </div>

            <div class="col-12 col-md-8">
                <div class="card-body p-4 p-lg-5">

                    <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-semibold mb-3">
                        🍕 Make It Your Way
                    </span>

                    <h2 class="h2 fw-bold mb-2">
                        Build Your Own Pizza
                    </h2>

                    <p class="text-muted mb-3">
                        Choose your size, crust, sauce, cheese, and favorite toppings.
                        Watch your pizza come together as you build it.
                    </p>

                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <span class="badge ingredient-pill">4 Sizes</span>
                        <span class="badge ingredient-pill">14 Toppings</span>
                        <span class="badge ingredient-pill">Live Pizza Preview</span>
                    </div>

                    <NavLink href="/builder"
                            class="btn btn-pizzapp-primary px-4 py-2">
                        <i class="bi bi-sliders me-1"></i>
                        Build Your Pizza
                    </NavLink>

                </div>
            </div>

        </div>
    </div>

    <!-- Specialty Pizzas Responsive Grid -->
    <div class="row g-4">
        @foreach (var pizza in SpecialtyPizzas)
        {
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden pizza-card">
                    <!-- Static Pizza Image -->
                    <div class="position-relative bg-light text-center p-3 pizza-img-container">
                        <img src="@pizza.ImagePath"
                             alt="@pizza.Name Pizza"
                             class="img-fluid pizza-card-img"
                             onerror="this.src='images/pizza-hero.png'" />
                        @if (!pizza.IsAvailable)
                        {
                            <span class="badge bg-secondary position-absolute top-0 start-0 m-3">Sold Out</span>
                        }
                    </div>

                    <!-- Pizza Details -->
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-baseline mb-1">
                            <h5 class="card-title fw-bold mb-0 text-dark">@pizza.Name</h5>
                            <span class="fs-5 fw-bold text-danger">$@pizza.SmallPrice.ToString("F2")</span>
                        </div>
                        <p class="card-text text-muted small mb-3">@pizza.Description</p>

                        <!-- Included Ingredients -->
                        <div class="mb-3 flex-grow-1">
                            <span class="text-uppercase small fw-bold text-muted d-block mb-2" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                                Included Ingredients:
                            </span>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var ingredient in pizza.Ingredients.OrderBy(ingredient => ingredient.SortOrder))
                                {
                                    <span class="badge ingredient-pill">@ingredient.Name</span>
                                }
                            </div>
                        </div>

                        <!-- Price Breakdown by Size -->
                        <div class="pt-3 border-top mt-auto">
                            <div class="d-flex justify-content-between text-muted small mb-3" style="font-size: 0.75rem;">
                                <span>SM: <strong>$@pizza.SmallPrice.ToString("F2")</strong></span>
                                <span>MD: <strong>$@pizza.MediumPrice.ToString("F2")</strong></span>
                                <span>LG: <strong>$@pizza.LargePrice.ToString("F2")</strong></span>
                                <span>XL: <strong>$@pizza.XLargePrice.ToString("F2")</strong></span>
                            </div>

                            @if (pizza.IsAvailable)
                            {
                                <button type="button"
                                        class="btn btn-pizzapp-primary w-100 rounded-3 py-2 d-flex align-items-center justify-content-center gap-2"
                                        @onclick="() => AddToCart(pizza)">
                                    <i class="bi bi-cart-plus"></i>
                                    Order Now
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-secondary w-100 rounded-3 py-2"
                                        disabled>
                                    <i class="bi bi-x-circle me-1"></i>
                                    Unavailable
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .pizza-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        background-color: #ffffff;
        border: 1px solid #EADBCE !important;
    }

    .pizza-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08) !important;
    }

    .pizza-img-container {
        height: 190px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #FFFDF9;
    }

    .pizza-card-img {
        max-height: 160px;
        object-fit: contain;
        transition: transform 0.3s ease;
    }

    .pizza-card:hover .pizza-card-img {
        transform: scale(1.06);
    }

    .ingredient-pill {
        background-color: #FFF8EB;
        color: #78350F;
        border: 1px solid #FDE68A;
        font-weight: 500;
        font-size: 0.73rem;
        padding: 0.25rem 0.5rem;
        border-radius: 9999px;
    }
</style>

@code {
    private List<SpecialtyPizza> SpecialtyPizzas = new();

    protected override async Task OnInitializedAsync()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();

        SpecialtyPizzas = await db.SpecialtyPizzas
            .Include(pizza => pizza.Ingredients)
            .AsNoTracking()
            .OrderBy(pizza => pizza.Id)
            .ToListAsync();
    }


    private void AddToCart(SpecialtyPizza pizza)
    {
        if (!pizza.IsAvailable)
        {
            return;
        }

        var cartItem = new CartItem
        {
            PizzaId = pizza.Id,
            PizzaName = pizza.Name,
            ImagePath = pizza.ImagePath,
            Size = "Small",
            BasePrice = pizza.SmallPrice,
            Quantity = 1
        };

        CartService.AddItem(cartItem);

        Navigation.NavigateTo("/cart");
}
}