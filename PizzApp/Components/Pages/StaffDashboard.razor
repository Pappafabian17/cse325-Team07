@page "/staff"
@page "/staff/dashboard"
@inject FrontendUserState UserState

<PageTitle>Staff Dashboard - PizzApp</PageTitle>

<div class="container-xl py-4 py-md-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="role-badge role-badge-staff">Staff Portal</span>
                <span class="text-muted small">&bull; Kitchen Display System (KDS)</span>
            </div>
            <h1 class="h2 fw-bold mb-0">Active Orders Dashboard</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                <i class="bi bi-circle-fill me-1" style="font-size: 0.6rem;"></i> Live Syncing
            </span>
            <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshOrders">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </button>
        </div>
    </div>

    @if (UserState.CurrentRole != "Staff" && UserState.CurrentRole != "Administrator")
    {
        <div class="alert alert-warning d-flex align-items-center justify-content-between p-3 mb-4 rounded-3 border-0 bg-light">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle text-warning fs-5"></i>
                <span class="small">
                    This is the Staff Dashboard view. In production, this view is restricted to employees.
                </span>
            </div>
            <button class="btn btn-sm btn-outline-dark" @onclick='() => UserState.SetRole("Staff")'>
                Switch to Staff Role
            </button>
        </div>
    }

    <!-- Kitchen Stats Overview -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
                <span class="text-muted small">Pending Prep</span>
                <span class="fs-3 fw-bold text-danger">3</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
                <span class="text-muted small">In The Oven</span>
                <span class="fs-3 fw-bold text-warning">4</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
                <span class="text-muted small">Ready for Pickup</span>
                <span class="fs-3 fw-bold text-success">2</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center">
                <span class="text-muted small">Avg. Prep Time</span>
                <span class="fs-3 fw-bold text-dark">14m</span>
            </div>
        </div>
    </div>

    <!-- Active Orders Kanban Grid -->
    <div class="row g-4">
        <!-- Order Card 1: Needs Prep -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-top border-4 border-danger">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <span class="badge bg-danger-subtle text-danger mb-1">New Order &bull; 4m ago</span>
                            <h5 class="fw-bold mb-0">#PA-98218</h5>
                        </div>
                        <span class="badge bg-light text-dark border">Delivery</span>
                    </div>

                    <div class="mb-3 flex-grow-1">
                        <h6 class="fw-semibold text-dark small mb-2 text-uppercase text-muted">Items to Prepare:</h6>
                        <ul class="list-group list-group-flush small">
                            <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                                <span><strong>1x</strong> XL Pepperoni (Hand Tossed)</span>
                                <span class="text-muted">Crust: Thin</span>
                            </li>
                            <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                                <span><strong>1x</strong> Medium Hawaiian</span>
                                <span class="text-muted">Extra Cheese</span>
                            </li>
                        </ul>
                    </div>

                    <div class="pt-3 border-top mt-auto">
                        <button class="btn btn-warning w-100 fw-semibold text-dark">
                            <i class="bi bi-fire me-1"></i> Send to Oven
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Card 2: Baking -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-top border-4 border-warning">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <span class="badge bg-warning-subtle text-dark mb-1">Baking &bull; 8m in oven</span>
                            <h5 class="fw-bold mb-0">#PA-98214</h5>
                        </div>
                        <span class="badge bg-light text-dark border">Pickup</span>
                    </div>

                    <div class="mb-3 flex-grow-1">
                        <h6 class="fw-semibold text-dark small mb-2 text-uppercase text-muted">Items in Oven:</h6>
                        <ul class="list-group list-group-flush small">
                            <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                                <span><strong>2x</strong> Large Classic Cheese</span>
                                <span class="text-muted">Well Done</span>
                            </li>
                            <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                                <span><strong>1x</strong> Garlic Knots (8pc)</span>
                                <span class="text-muted">Side: Marinara</span>
                            </li>
                        </ul>
                    </div>

                    <div class="pt-3 border-top mt-auto">
                        <button class="btn btn-success w-100 fw-semibold">
                            <i class="bi bi-check2-circle me-1"></i> Mark as Ready
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Card 3: Ready for Delivery -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-top border-4 border-success">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <span class="badge bg-success-subtle text-success mb-1">Ready for Driver</span>
                            <h5 class="fw-bold mb-0">#PA-98210</h5>
                        </div>
                        <span class="badge bg-light text-dark border">Delivery</span>
                    </div>

                    <div class="mb-3 flex-grow-1">
                        <h6 class="fw-semibold text-dark small mb-2 text-uppercase text-muted">Bagged & Boxed:</h6>
                        <ul class="list-group list-group-flush small">
                            <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                                <span><strong>1x</strong> Sausage & Pepperoni</span>
                                <span class="text-success fw-bold">Boxed</span>
                            </li>
                        </ul>
                    </div>

                    <div class="pt-3 border-top mt-auto">
                        <button class="btn btn-outline-dark w-100 fw-semibold">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Hand off to Driver
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private void RefreshOrders()
    {
        StateHasChanged();
    }
}
