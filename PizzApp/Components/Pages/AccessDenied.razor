@page "/access-denied"

<PageTitle>Access Denied - PizzApp</PageTitle>

<div class="container-xl py-5 text-center">
    <div class="card border-0 shadow-sm rounded-4 p-5 mx-auto bg-white" style="max-width: 520px;">
        <div class="mb-3 text-danger">
            <i class="bi bi-shield-x" style="font-size: 4rem;"></i>
        </div>
        <h1 class="h3 fw-bold mb-2">Access Denied</h1>
        <p class="text-muted mb-4">
            You do not have the necessary permissions or role to access this area.
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a href="" class="btn btn-outline-secondary px-3">Return to Home</a>
            <a href="login" class="btn btn-danger px-3">Switch Account</a>
        </div>
    </div>
</div>
