@page "/profile"
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.DependencyInjection
@using PizzApp.Models
@inject AuthenticationStateProvider AuthStateProvider
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Navigation

<PageTitle>Profile & Account Settings - PizzApp</PageTitle>

<div class="container-xl py-4 py-md-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h1 class="h2 fw-bold mb-1">Profile & Account Settings</h1>
            <p class="text-muted mb-0">Manage your contact information, default delivery address, and security.</p>
        </div>
        <div>
            <form method="post" action="/Account/Logout" class="d-inline">
                <button type="submit" class="btn btn-outline-danger px-3">
                    <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                </button>
            </form>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" role="status"></div>
            <p class="text-muted small mt-2">Loading your profile information...</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- User Info Summary Card -->
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                    <div class="mx-auto mb-3" style="width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, #C83A2A 0%, #F2B84B 100%); color: #fff; font-size: 2rem; font-weight: 700; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 15px rgba(200, 58, 42, 0.25);">
                        @(_displayName.Length > 0 ? char.ToUpper(_displayName[0]) : 'U')
                    </div>
                    <h2 class="h5 fw-bold mb-1">@_displayName</h2>
                    <p class="text-muted small mb-2">@_userEmail</p>
                    <div class="mb-3">
                        <span class="role-badge @GetRoleBadgeClass(_userRole)">
                            @_userRole
                        </span>
                    </div>
                    <div class="border-top pt-3 text-start small text-muted">
                        <div class="d-flex justify-content-between py-1">
                            <span>Account Status:</span>
                            <span class="badge bg-success-subtle text-success">Active & Verified</span>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span>Authentication:</span>
                            <span class="text-dark fw-medium">ASP.NET Core Identity</span>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span>Current Role:</span>
                            <span class="text-dark fw-semibold">@_userRole</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Settings Forms -->
            <div class="col-12 col-lg-8">
                <!-- Delivery Address & Personal Details Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                    <h3 class="h5 fw-bold mb-1 d-flex align-items-center gap-2">
                        <i class="bi bi-geo-alt text-danger"></i> Default Delivery Address & Contact
                    </h3>
                    <p class="text-muted small mb-4">This address will be automatically used when placing orders for delivery.</p>

                    @if (!string.IsNullOrWhiteSpace(_addressSuccessMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 py-2 px-3 mb-3 rounded-3 small" role="alert">
                            <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                            <div>@_addressSuccessMessage</div>
                            <button type="button" class="btn-close ms-auto" @onclick="() => _addressSuccessMessage = null"></button>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_addressErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 py-2 px-3 mb-3 rounded-3 small" role="alert">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                            <div>@_addressErrorMessage</div>
                            <button type="button" class="btn-close ms-auto" @onclick="() => _addressErrorMessage = null"></button>
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label for="fullNameInput" class="form-label small fw-semibold text-dark">Full Name</label>
                            <input id="fullNameInput" type="text" class="form-control" @bind="_fullName" placeholder="e.g. Alex Customer" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="emailInput" class="form-label small fw-semibold text-dark">Email Address</label>
                            <input id="emailInput" type="email" class="form-control bg-light" value="@_userEmail" disabled readonly />
                            <div class="form-text" style="font-size: 0.75rem;">Email is associated with your account credentials.</div>
                        </div>
                        <div class="col-12">
                            <label for="deliveryAddressInput" class="form-label small fw-semibold text-dark">Street Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-geo-alt"></i>
                                </span>
                                <input id="deliveryAddressInput"
                                       type="text"
                                       class="form-control border-start-0"
                                       @bind="_deliveryStreet"
                                       placeholder="e.g. 123 Campus Dr, Rexburg, ID 83440" />
                            </div>
                        </div>
                        <div class="col-12 mt-3">
                            <button class="btn btn-pizzapp-primary" @onclick="SaveAddressAsync" disabled="@_isSavingAddress">
                                @if (_isSavingAddress)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    <span>Saving Address...</span>
                                }
                                else
                                {
                                    <i class="bi bi-save me-1"></i>
                                    <span>Save Address</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Password & Security Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h3 class="h5 fw-bold mb-1 d-flex align-items-center gap-2">
                        <i class="bi bi-shield-lock text-danger"></i> Password & Security
                    </h3>
                    <p class="text-muted small mb-4">Change your password or update your login credentials.</p>

                    @if (!string.IsNullOrWhiteSpace(_passwordSuccessMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 py-2 px-3 mb-3 rounded-3 small" role="alert">
                            <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                            <div>@_passwordSuccessMessage</div>
                            <button type="button" class="btn-close ms-auto" @onclick="() => _passwordSuccessMessage = null"></button>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_passwordErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 py-2 px-3 mb-3 rounded-3 small" role="alert">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                            <div>@_passwordErrorMessage</div>
                            <button type="button" class="btn-close ms-auto" @onclick="() => _passwordErrorMessage = null"></button>
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-12">
                            <label for="currentPasswordInput" class="form-label small fw-semibold text-dark">Current Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-key"></i>
                                </span>
                                <input id="currentPasswordInput"
                                       type="password"
                                       class="form-control border-start-0"
                                       @bind="_currentPassword"
                                       placeholder="Enter current password"
                                       autocomplete="current-password" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label for="newPasswordInput" class="form-label small fw-semibold text-dark">New Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-shield-check"></i>
                                </span>
                                <input id="newPasswordInput"
                                       type="password"
                                       class="form-control border-start-0"
                                       @bind="_newPassword"
                                       placeholder="At least 6 characters"
                                       autocomplete="new-password" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label for="confirmPasswordInput" class="form-label small fw-semibold text-dark">Confirm New Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-shield-lock-fill"></i>
                                </span>
                                <input id="confirmPasswordInput"
                                       type="password"
                                       class="form-control border-start-0"
                                       @bind="_confirmNewPassword"
                                       placeholder="Repeat new password"
                                       autocomplete="new-password" />
                            </div>
                        </div>
                        <div class="col-12 mt-3">
                            <button class="btn btn-outline-dark" @onclick="ChangePasswordAsync" disabled="@_isSavingPassword">
                                @if (_isSavingPassword)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    <span>Updating Password...</span>
                                }
                                else
                                {
                                    <i class="bi bi-lock me-1"></i>
                                    <span>Update Password</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool _isLoading = true;
    private string _userId = string.Empty;
    private string _displayName = "User";
    private string _fullName = string.Empty;
    private string _userEmail = string.Empty;
    private string _userRole = "Customer";

    // Delivery address form
    private string _deliveryStreet = string.Empty;
    private bool _isSavingAddress = false;
    private string? _addressSuccessMessage;
    private string? _addressErrorMessage;

    // Password form
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmNewPassword = string.Empty;
    private bool _isSavingPassword = false;
    private string? _passwordSuccessMessage;
    private string? _passwordErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserProfileAsync();
    }

    private async Task LoadUserProfileAsync()
    {
        _isLoading = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var claimsUser = authState.User;

            if (claimsUser.Identity?.IsAuthenticated == true)
            {
                await using var scope = ScopeFactory.CreateAsyncScope();
                var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();

                var user = await userManager.GetUserAsync(claimsUser)
                           ?? (claimsUser.Identity?.Name != null ? await userManager.FindByNameAsync(claimsUser.Identity.Name) : null)
                           ?? (claimsUser.Identity?.Name != null ? await userManager.FindByEmailAsync(claimsUser.Identity.Name) : null);

                if (user != null)
                {
                    _userId = user.Id;
                    _userEmail = user.Email ?? user.UserName ?? string.Empty;
                    _fullName = user.FullName ?? string.Empty;
                    _displayName = !string.IsNullOrWhiteSpace(user.FullName) ? user.FullName : (!string.IsNullOrWhiteSpace(user.UserName) ? user.UserName : "User");
                    _deliveryStreet = user.DeliveryAddress ?? string.Empty;

                    var roles = await userManager.GetRolesAsync(user);
                    _userRole = roles.FirstOrDefault()
                                ?? (claimsUser.IsInRole("Administrator") ? "Administrator"
                                : claimsUser.IsInRole("Staff") ? "Staff"
                                : "Customer");
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            _addressErrorMessage = "We couldn't load your profile. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAddressAsync()
    {
        _addressSuccessMessage = null;
        _addressErrorMessage = null;
        _isSavingAddress = true;

        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
            var user = await userManager.FindByIdAsync(_userId);

            if (user == null)
            {
                _addressErrorMessage = "User account not found. Please log in again.";
                return;
            }

            user.DeliveryAddress = _deliveryStreet?.Trim();
            user.FullName = _fullName?.Trim() ?? string.Empty;

            var result = await userManager.UpdateAsync(user);
            if (result.Succeeded)
            {
                _displayName = !string.IsNullOrWhiteSpace(user.FullName) ? user.FullName : user.UserName ?? "User";
                _addressSuccessMessage = "Default delivery address and contact information saved successfully!";
            }
            else
            {
                _addressErrorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            _addressErrorMessage = "We couldn't save your profile changes. Please try again.";
        }
        finally
        {
            _isSavingAddress = false;
        }
    }

    private async Task ChangePasswordAsync()
    {
        _passwordSuccessMessage = null;
        _passwordErrorMessage = null;

        if (string.IsNullOrWhiteSpace(_currentPassword))
        {
            _passwordErrorMessage = "Please enter your current password.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            _passwordErrorMessage = "Please enter your new password.";
            return;
        }

        if (_newPassword.Length < 6)
        {
            _passwordErrorMessage = "The new password must be at least 6 characters long.";
            return;
        }

        if (_newPassword != _confirmNewPassword)
        {
            _passwordErrorMessage = "The new password and confirmation do not match.";
            return;
        }

        _isSavingPassword = true;

        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
            var user = await userManager.FindByIdAsync(_userId);

            if (user == null)
            {
                _passwordErrorMessage = "User account not found. Please log in again.";
                return;
            }

            var result = await userManager.ChangePasswordAsync(user, _currentPassword, _newPassword);
            if (result.Succeeded)
            {
                _passwordSuccessMessage = "Your password has been updated successfully!";
                _currentPassword = string.Empty;
                _newPassword = string.Empty;
                _confirmNewPassword = string.Empty;
            }
            else
            {
                _passwordErrorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            _passwordErrorMessage = "We couldn't update your password. Please try again.";
        }
        finally
        {
            _isSavingPassword = false;
        }
    }

    private static string GetRoleBadgeClass(string? role) => role switch
    {
        "Customer" => "role-badge-customer",
        "Staff" => "role-badge-staff",
        "Administrator" => "role-badge-admin",
        _ => "role-badge-customer"
    };
}