@page "/checkout"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using PizzApp.Data
@using PizzApp.Models
@using PizzApp.Services

@inject CartService CartService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<PizzAppDbContext> DbFactory
@inject ILogger<Checkout> Logger

@attribute [Authorize(Roles = "Customer,Administrator")]

<PageTitle>Checkout - PizzApp</PageTitle>

<div class="container-xl py-4 py-md-5">

    <div class="mb-4 pb-3 border-bottom">
        <h1 class="h2 fw-bold mb-1">Checkout</h1>
        <p class="text-muted mb-0">
            Review your order and confirm your purchase.
        </p>
    </div>

    @if (OrderPlaced)
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center">

            <div class="mb-3">
                <i class="bi bi-check-circle-fill text-success display-3"></i>
            </div>

            <h2 class="h3 fw-bold mb-2">
                Order Confirmed!
            </h2>

            <p class="text-muted mb-2">
                Thank you for your order, @(_currentUser?.FullName ?? "Customer").
            </p>

            <p class="fw-semibold mb-2">
                Order #@PlacedOrderNumber
            </p>

            @if (SelectedFulfillment == FulfillmentType.Pickup)
            {
                <p class="text-muted">
                    Your order has been received and is being prepared for pickup at
                    <strong>PizzApp Store #1</strong>.
                </p>
            }
            else
            {
                <p class="text-muted">
                    Your order has been received and is being prepared for delivery.
                </p>
            }

            <div class="alert alert-light border rounded-3 my-4">
                <div class="fw-bold">Order Total</div>
                <div class="fs-3 text-danger fw-bold">
                    $@OrderTotal.ToString("0.00")
                </div>
            </div>

            <div class="d-flex justify-content-center gap-2 flex-wrap">

                <NavLink href="menu" class="btn btn-outline-secondary">
                    <i class="bi bi-pizza me-1"></i>
                    Order More Pizza
                </NavLink>

                <NavLink href="orders" class="btn btn-pizzapp-primary">
                    <i class="bi bi-receipt me-1"></i>
                    View Orders
                </NavLink>

            </div>

        </div>
    }
    else if (CartService.Items.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center">

            <i class="bi bi-cart-x display-3 text-muted mb-3"></i>

            <h2 class="h4 fw-bold">
                Your cart is empty
            </h2>

            <p class="text-muted mb-4">
                Add a pizza to your cart before checking out.
            </p>

            <div>
                <NavLink href="menu" class="btn btn-pizzapp-primary">
                    <i class="bi bi-pizza me-1"></i>
                    Browse Menu
                </NavLink>
            </div>

        </div>
    }
    else
    {
        <div class="row g-4">

            <!-- Customer Information -->
            <div class="col-12 col-lg-7">

                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">

                    <h2 class="h5 fw-bold mb-4">
                        <i class="bi bi-person me-2 text-danger"></i>
                        Customer Information
                    </h2>

                    <div class="mb-3">
                        <label for="checkout-name" class="form-label fw-semibold">
                            Name
                        </label>

                        <input id="checkout-name"
                               class="form-control"
                               value="@(_currentUser?.FullName ?? string.Empty)"
                               readonly />
                    </div>

                    <div class="mb-4">
                        <label for="checkout-email" class="form-label fw-semibold">
                            Email
                        </label>

                        <input id="checkout-email"
                               class="form-control"
                               value="@(_currentUser?.Email ?? string.Empty)"
                               readonly />
                    </div>

                    <div class="mb-4">
                        <div class="form-label fw-semibold">
                            Order Type
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <button type="button"
                                    class="btn @(SelectedFulfillment == FulfillmentType.Pickup ? "btn-pizzapp-primary" : "btn-outline-secondary")"
                                    aria-pressed="@(SelectedFulfillment == FulfillmentType.Pickup ? "true" : "false")"
                                    @onclick="() => SelectedFulfillment = FulfillmentType.Pickup">
                                <i class="bi bi-shop me-1"></i>
                                Pickup
                            </button>

                            <button type="button"
                                    class="btn @(SelectedFulfillment == FulfillmentType.Delivery ? "btn-pizzapp-primary" : "btn-outline-secondary")"
                                    aria-pressed="@(SelectedFulfillment == FulfillmentType.Delivery ? "true" : "false")"
                                    @onclick="() => SelectedFulfillment = FulfillmentType.Delivery">
                                <i class="bi bi-truck me-1"></i>
                                Delivery
                            </button>
                        </div>
                    </div>

                    @if (SelectedFulfillment == FulfillmentType.Delivery)
                    {
                        <div class="mb-0">
                            <label for="checkout-delivery-address" class="form-label fw-semibold">
                                Delivery Address
                            </label>

                            <textarea id="checkout-delivery-address"
                                      class="form-control"
                                      rows="3"
                                      @bind="DeliveryAddress"
                                      placeholder="Enter your delivery address"></textarea>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border rounded-3 mb-0">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                            <strong>Pickup at:</strong> PizzApp Store #1
                        </div>
                    }

                </div>

                <!-- Order Items -->
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">

                    <h2 class="h5 fw-bold mb-4">
                        <i class="bi bi-cart3 me-2 text-danger"></i>
                        Your Order
                    </h2>

                    <div class="d-flex flex-column gap-3">

                        @foreach (var item in CartService.Items)
                        {
                            <div class="d-flex align-items-center justify-content-between gap-3 p-3 bg-light rounded-3">

                                <div class="d-flex align-items-center gap-3">

                                    @if (item.IsCustom)
                                    {
                                        <div style="width: 90px; height: 90px; flex: 0 0 90px;">
                                            <CustomPizzaPreview
                                                ToppingNames="item.Toppings.Select(topping => topping.Name)"
                                                AltText="@item.PizzaName" />
                                        </div>
                                    }
                                    else
                                    {
                                        <img src="@item.ImagePath"
                                             alt="@item.PizzaName"
                                             class="rounded-3"
                                             style="width: 90px; height: 90px; object-fit: contain;"
                                             onerror="this.src='images/pizza-hero.png'" />
                                    }

                                    <div>
                                        <div class="fw-bold">
                                            @item.Size @item.PizzaName Pizza
                                        </div>

                                        <div class="text-muted small">
                                            Quantity: @item.Quantity
                                        </div>
                                    </div>

                                </div>

                                <div class="fw-bold">
                                    $@item.TotalPrice.ToString("0.00")
                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>

            <!-- Order Summary -->
            <div class="col-12 col-lg-5">

                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">

                    <h2 class="h5 fw-bold mb-4">
                        Order Summary
                    </h2>

                    <div class="d-flex justify-content-between py-2 text-muted">
                        <span>Subtotal</span>
                        <span class="fw-semibold text-dark">
                            $@CartService.Subtotal.ToString("0.00")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between py-2 text-muted">
                        <span>Delivery Fee</span>
                        <span class="fw-semibold text-dark">
                            $@SelectedDeliveryFee.ToString("0.00")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between py-2 text-muted">
                        <span>Sales Tax (@CartService.SalesTaxPercent.ToString("0.##")%)</span>
                        <span class="fw-semibold text-dark">
                            $@CartService.Tax.ToString("0.00")
                        </span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between fs-5 fw-bold mb-4">
                        <span>Total</span>

                        <span class="text-danger">
                            $@CheckoutTotal.ToString("0.00")
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @ErrorMessage
                        </div>
                    }

                    <button type="button"
                            class="btn btn-pizzapp-primary w-100 py-2"
                            @onclick="PlaceOrder"
                            disabled="@IsSubmitting">
                        @if (IsSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Placing Order...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle me-1"></i>
                            <span>Place Order</span>
                        }
                    </button>

                    <NavLink href="cart"
                             class="btn btn-outline-secondary w-100 py-2 mt-2">
                        <i class="bi bi-arrow-left me-1"></i>
                        Back to Cart
                    </NavLink>

                    <p class="text-muted text-center small mt-3 mb-0">
                        <i class="bi bi-shield-check text-success me-1"></i>
                        Secure checkout
                    </p>

                </div>

            </div>

        </div>
    }

</div>

@code {
    private ApplicationUser? _currentUser;

    private string DeliveryAddress { get; set; } = string.Empty;

    private FulfillmentType SelectedFulfillment { get; set; } =
        FulfillmentType.Delivery;

    private bool OrderPlaced { get; set; }

    private bool IsSubmitting { get; set; }

    private decimal OrderTotal { get; set; }

    private string PlacedOrderNumber { get; set; } = string.Empty;

    private string ErrorMessage { get; set; } = string.Empty;

    private decimal SelectedDeliveryFee =>
        SelectedFulfillment == FulfillmentType.Delivery
            ? CartService.DeliveryFee
            : 0m;

    private decimal CheckoutTotal =>
        CartService.Subtotal +
        CartService.Tax +
        SelectedDeliveryFee;

    protected override async Task OnInitializedAsync()
{
    await CartService.LoadStoreSettingsAsync();

    var authenticationState =
        await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var userId = authenticationState.User
            .FindFirst(ClaimTypes.NameIdentifier)?
            .Value;

        if (string.IsNullOrWhiteSpace(userId))
        {
            return;
        }

        await using var db =
            await DbFactory.CreateDbContextAsync();

        _currentUser = await db.Users
            .AsNoTracking()
            .FirstOrDefaultAsync(user => user.Id == userId);

        if (_currentUser is not null &&
            !string.IsNullOrWhiteSpace(_currentUser.DeliveryAddress))
        {
            DeliveryAddress = _currentUser.DeliveryAddress;
        }
    }

    private async Task PlaceOrder()
    {
        ErrorMessage = string.Empty;

        if (IsSubmitting)
        {
            return;
        }

        if (_currentUser is null)
        {
            ErrorMessage =
                "Your account information could not be loaded. Please sign in again.";
            return;
        }

        if (CartService.Items.Count == 0)
        {
            ErrorMessage =
                "Your cart is empty.";
            return;
        }

        if (SelectedFulfillment == FulfillmentType.Delivery &&
            string.IsNullOrWhiteSpace(DeliveryAddress))
        {
            ErrorMessage =
                "Please enter a delivery address.";
            return;
        }

        IsSubmitting = true;

        try
        {
            // Persist the cart's current values as an order snapshot; later menu or tax changes must not alter history.
            var order = new Order
            {
                CustomerId = _currentUser.Id,
                CustomerName = _currentUser.FullName,
                CustomerEmail =
                    _currentUser.Email ??
                    _currentUser.UserName ??
                    string.Empty,

                FulfillmentType = SelectedFulfillment,

                DeliveryAddress =
                    SelectedFulfillment == FulfillmentType.Delivery
                        ? DeliveryAddress.Trim()
                        : null,

                PlacedAt = DateTimeOffset.UtcNow,
                Status = OrderStatus.Received,

                Subtotal = CartService.Subtotal,
                Tax = CartService.Tax,
                DeliveryFee = SelectedDeliveryFee,
                Total = CheckoutTotal,

                Items = CartService.Items
                    .Select(item => new OrderItem
                    {
                        SpecialtyPizzaId =
                            !item.IsCustom && item.PizzaId > 0
                                ? item.PizzaId
                                : null,

                        IsCustom = item.IsCustom,
                        PizzaName = item.PizzaName,
                        Size = item.Size,
                        Crust = item.Crust,
                        Sauce = item.Sauce,
                        Cheese = item.Cheese,

                        Toppings = string.Join(
                            ", ",
                            item.Toppings.Select(topping => topping.Name)),

                        Quantity = item.Quantity,
                        UnitPrice = item.UnitPrice,
                        TotalPrice = item.TotalPrice
                    })
                    .ToList()
            };

            await using var db =
                await DbFactory.CreateDbContextAsync();

            db.Orders.Add(order);

            await db.SaveChangesAsync();

            OrderTotal = order.Total;
            PlacedOrderNumber = order.OrderNumber;

            // Clear only after the database save succeeds; failures leave the cart available for retry.
            CartService.Clear();

            OrderPlaced = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Failed to save order for customer {CustomerId}.",
                _currentUser.Id);

            ErrorMessage =
                "We couldn't place your order. Your cart has been kept. Please try again.";
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}
