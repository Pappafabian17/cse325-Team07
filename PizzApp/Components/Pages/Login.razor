@page "/login"

<PageTitle>Sign In - PizzApp</PageTitle>

<div class="container-xl py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle p-3 mb-3">
                        <i class="bi bi-person-lock fs-2"></i>
                    </div>
                    <h1 class="h3 fw-bold mb-1">Welcome Back</h1>
                    <p class="text-muted small">Sign in to your PizzApp account</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(Error))
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 mb-4 rounded-3 small" role="alert">
                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                        <div>@Error</div>
                    </div>
                }

                <form method="post" action="/Account/Login">
                    <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                    <div class="mb-3">
                        <label for="email" class="form-label small fw-semibold">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input type="email"
                                   id="email"
                                   name="email"
                                   class="form-control border-start-0"
                                   placeholder="name@example.com"
                                   required
                                   autocomplete="username" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label small fw-semibold">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-key"></i>
                            </span>
                            <input type="password"
                                   id="password"
                                   name="password"
                                   class="form-control border-start-0"
                                   placeholder="••••••••"
                                   required
                                   autocomplete="current-password" />
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="rememberMe" name="rememberMe" value="true" />
                            <label class="form-check-label small text-muted" for="rememberMe">
                                Remember me
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-pizzapp-primary w-100 py-2 fw-semibold shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top">
                    <p class="small text-muted mb-0">
                        Don't have an account?
                        <a href="register" class="text-danger fw-semibold text-decoration-none ms-1">Register now</a>
                    </p>
                </div>
            </div>

            <!-- Demo Quick-Login Helper for CSE 325 Testing -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mt-4 bg-light">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-lightning-charge-fill text-warning"></i>
                    <h2 class="h6 fw-bold mb-0">Quick Demo Logins (CSE 325)</h2>
                </div>
                <p class="text-muted" style="font-size: 0.8rem;">
                    Click a role below to quickly sign in as a pre-seeded account for grading and testing:
                </p>
                <div class="d-grid gap-2">
                    <form method="post" action="/Account/QuickLogin" class="d-inline">
                        <input type="hidden" name="role" value="Administrator" />
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100 text-start d-flex justify-content-between align-items-center py-2 px-3 bg-white">
                            <span><i class="bi bi-shield-lock me-2 text-danger"></i><strong>Administrator</strong> (Jordan)</span>
                            <span class="badge bg-danger-subtle text-danger">admin@pizzapp.com</span>
                        </button>
                    </form>
                    <form method="post" action="/Account/QuickLogin" class="d-inline">
                        <input type="hidden" name="role" value="Staff" />
                        <button type="submit" class="btn btn-sm btn-outline-warning w-100 text-start d-flex justify-content-between align-items-center py-2 px-3 bg-white">
                            <span><i class="bi bi-clipboard2-check me-2 text-warning"></i><strong>Staff</strong> (Sam)</span>
                            <span class="badge bg-warning-subtle text-warning">staff@pizzapp.com</span>
                        </button>
                    </form>
                    <form method="post" action="/Account/QuickLogin" class="d-inline">
                        <input type="hidden" name="role" value="Customer" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary w-100 text-start d-flex justify-content-between align-items-center py-2 px-3 bg-white">
                            <span><i class="bi bi-person me-2 text-primary"></i><strong>Customer</strong> (Alex)</span>
                            <span class="badge bg-secondary-subtle text-dark">customer@pizzapp.com</span>
                        </button>
                    </form>
                </div>
                <div class="text-muted mt-2 text-center" style="font-size: 0.75rem;">
                    Pre-seeded password for manual login: <code>Admin123!</code> / <code>Staff123!</code> / <code>Customer123!</code>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }
}
