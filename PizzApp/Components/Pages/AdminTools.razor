    private async Task CreateStaffAsync()
    {
        if (_isCreatingStaff)
        {
            return;
        }

        _addStaffError = string.Empty;
        _staffSuccess = string.Empty;

        var fullName =
            _newStaffFullName.Trim();

        var email =
            _newStaffEmail.Trim();

        if (string.IsNullOrWhiteSpace(fullName))
        {
            _addStaffError =
                "Full name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(email) ||
            !email.Contains('@'))
        {
            _addStaffError =
                "Enter a valid email address.";
            return;
        }

        if (_newStaffRole != "Staff" &&
            _newStaffRole != "Administrator")
        {
            _addStaffError =
                "Select a valid staff role.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_newStaffPassword) ||
            _newStaffPassword.Length < 6)
        {
            _addStaffError =
                "The password must be at least 6 characters.";
            return;
        }

        if (_newStaffPassword !=
            _newStaffConfirmPassword)
        {
            _addStaffError =
                "The passwords do not match.";
            return;
        }

        _isCreatingStaff = true;

        try
        {
            await using var scope =
                ScopeFactory.CreateAsyncScope();

            var userManager =
                scope.ServiceProvider
                    .GetRequiredService<UserManager<ApplicationUser>>();

            var existingUser =
                await userManager.FindByEmailAsync(email);

            if (existingUser is not null)
            {
                _addStaffError =
                    "An account with that email address already exists.";
                return;
            }

            var user = new ApplicationUser
            {
                UserName = email,
                Email = email,
                FullName = fullName,
                EmailConfirmed = true,

                // Required for the Enable / Disable account
                // feature we will add next.
                LockoutEnabled = true
            };

            var createResult =
                await userManager.CreateAsync(
                    user,
                    _newStaffPassword);

            if (!createResult.Succeeded)
            {
                _addStaffError =
                    string.Join(
                        " ",
                        createResult.Errors
                            .Select(error => error.Description));

                return;
            }

            var roleResult =
                await userManager.AddToRoleAsync(
                    user,
                    _newStaffRole);

            if (!roleResult.Succeeded)
            {
                // Avoid leaving behind an account with no staff role.
                await userManager.DeleteAsync(user);

                _addStaffError =
                    string.Join(
                        " ",
                        roleResult.Errors
                            .Select(error => error.Description));

                return;
            }

            var createdName =
                user.FullName;

            _showAddStaffForm = false;

            ResetNewStaffForm();

            await LoadStaffAccountsAsync();

            _staffSuccess =
                $"{createdName} was created successfully.";
        }
        catch
        {
            _addStaffError =
                "We couldn't create the staff account. Please try again.";
        }
        finally
        {
            _isCreatingStaff = false;
        }
    }

