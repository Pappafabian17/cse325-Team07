@page "/admin/tools"
@attribute [Authorize(Roles = "Administrator")]

@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using PizzApp.Data
@using PizzApp.Models
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject IDbContextFactory<PizzAppDbContext> DbFactory
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Admin Tools - PizzApp</PageTitle>

<div class="container-xl py-4 py-md-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="role-badge role-badge-admin">Admin Portal</span>
                <span class="text-muted small">&bull; Store Administration</span>
            </div>
            <h1 class="h2 fw-bold mb-0">Administrator Tools & Controls</h1>
        </div>
        <div>
            <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">
                <i class="bi bi-shield-check me-1"></i> Admin Privileges Active
            </span>
        </div>
    </div>


    <!-- Navigation Pills / Section Selector -->
    <ul class="nav nav-pills mb-4 gap-2" id="adminTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeTab == "sales" ? "active" : "")" 
                    @onclick='() => _activeTab = "sales"'>
                <i class="bi bi-graph-up-arrow me-1"></i> Sales Summary
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeTab == "menu" ? "active" : "")" 
                    @onclick='() => _activeTab = "menu"'>
                <i class="bi bi-card-list me-1"></i> Menu Controls
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeTab == "staff" ? "active" : "")" 
                    @onclick='() => _activeTab = "staff"'>
                <i class="bi bi-people me-1"></i> Staff Management
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeTab == "settings" ? "active" : "")" 
                    @onclick='() => _activeTab = "settings"'>
                <i class="bi bi-sliders me-1"></i> Store Settings
            </button>
        </li>
    </ul>

    <!-- 1. Sales Summary Section -->
    @if (_activeTab == "sales")
    {
        @if (_isLoadingSales)
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center">
                <div class="spinner-border text-danger mx-auto mb-3"
                    role="status">
                </div>

                <p class="text-muted mb-0">
                    Loading sales summary...
                </p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_salesError))
        {
            <div class="alert alert-danger" role="alert">
                @_salesError
            </div>
        }
        else
        {
            <div class="row g-4 mb-4">

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <span class="text-muted small fw-semibold text-uppercase">
                            Today's Revenue
                        </span>

                        <span class="fs-2 fw-bold text-dark mt-2">
                            $@_todayRevenue.ToString("N2")
                        </span>

                        <span class="text-muted small mt-1">
                            From @_todayOrderCount order@(_todayOrderCount == 1 ? "" : "s")
                        </span>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <span class="text-muted small fw-semibold text-uppercase">
                            Orders Placed
                        </span>

                        <span class="fs-2 fw-bold text-dark mt-2">
                            @_todayOrderCount
                        </span>

                        <span class="text-muted small mt-1">
                            @_activeOrderCount active currently
                        </span>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <span class="text-muted small fw-semibold text-uppercase">
                            Average Ticket
                        </span>

                        <span class="fs-2 fw-bold text-dark mt-2">
                            $@_averageTicket.ToString("N2")
                        </span>

                        <span class="text-muted small mt-1">
                            @_averageItemsPerOrder.ToString("0.0") items / order
                        </span>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <span class="text-muted small fw-semibold text-uppercase">
                            Top Pizza
                        </span>

                        <span class="fs-2 fw-bold text-danger mt-2">
                            @_topPizzaName
                        </span>

                        <span class="text-muted small mt-1">
                            @_topPizzaDetail
                        </span>
                    </div>
                </div>

            </div>
        }
    }

    <!-- 2. Menu Controls Section -->
    @if (_activeTab == "menu")
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="h5 fw-bold mb-0">Menu & Specialty Pizzas Control</h4>
            </div>
            <div class="table-responsive">
                @if (!string.IsNullOrWhiteSpace(_menuError))
                {
                    <div class="alert alert-danger mb-3"
                        role="alert">
                        @_menuError
                    </div>
                }
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Pizza Name</th>
                            <th>Starting Price</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_isLoadingMenu)
                        {
                            <tr>
                                <td colspan="4"
                                    class="text-center text-muted py-4">

                                    <div class="spinner-border spinner-border-sm text-danger me-2"
                                        role="status">
                                    </div>

                                    Loading menu...
                                </td>
                            </tr>
                        }
                        else if (_specialtyPizzas.Count == 0)
                        {
                            <tr>
                                <td colspan="4"
                                    class="text-center text-muted py-4">
                                    No specialty pizzas found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var pizza in _specialtyPizzas)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @pizza.Name Pizza
                                    </td>

                                    <td>
                                        $@pizza.SmallPrice.ToString("0.00")
                                    </td>

                                    <td>
                                        @if (pizza.IsAvailable)
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">
                                                Unavailable
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">

                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary me-2"
                                                @onclick="() => StartEditPizza(pizza)"
                                                disabled="@_isSavingPizza">
                                            Edit
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm @(pizza.IsAvailable
                                                    ? "btn-outline-danger"
                                                    : "btn-outline-success")"
                                                @onclick="() => TogglePizzaAvailabilityAsync(pizza)"
                                                disabled="@_updatingPizzaIds.Contains(pizza.Id)">

                                            @if (_updatingPizzaIds.Contains(pizza.Id))
                                            {
                                                <span class="spinner-border spinner-border-sm"></span>
                                            }
                                            else if (pizza.IsAvailable)
                                            {
                                                <span>Disable</span>
                                            }
                                            else
                                            {
                                                <span>Enable</span>
                                            }

                                        </button>

                                    </td>

                                </tr>
                            }

                        }
                    </tbody>
                </table>
            </div>
            @if (_editingPizza is not null)
            {
                <div class="border-top pt-4 mt-3"
                    @ref="_editPanel"
                    tabindex="-1"
                    style="outline: none;">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold mb-1">
                                Edit Specialty Pizza
                            </h5>

                            <p class="text-muted small mb-0">
                                Update the menu details and prices for @_editingPizza.Name.
                            </p>
                        </div>

                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="CancelEditPizza"
                                disabled="@_isSavingPizza">
                            Cancel
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_editPizzaError))
                    {
                        <div class="alert alert-danger"
                            role="alert">
                            @_editPizzaError
                        </div>
                    }

                    <div class="row g-3">

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                Pizza Name
                            </label>

                            <input type="text"
                                class="form-control"
                                @bind="_editingPizza.Name" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                Image Path
                            </label>

                            <input type="text"
                                class="form-control"
                                @bind="_editingPizza.ImagePath" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea class="form-control"
                                    rows="3"
                                    @bind="_editingPizza.Description">
                            </textarea>
                        </div>

                        <div class="col-6 col-lg-3">
                            <label class="form-label fw-semibold">
                                Small Price
                            </label>

                            <input type="number"
                                step="0.01"
                                min="0"
                                class="form-control"
                                @bind="_editingPizza.SmallPrice" />
                        </div>

                        <div class="col-6 col-lg-3">
                            <label class="form-label fw-semibold">
                                Medium Price
                            </label>

                            <input type="number"
                                step="0.01"
                                min="0"
                                class="form-control"
                                @bind="_editingPizza.MediumPrice" />
                        </div>

                        <div class="col-6 col-lg-3">
                            <label class="form-label fw-semibold">
                                Large Price
                            </label>

                            <input type="number"
                                step="0.01"
                                min="0"
                                class="form-control"
                                @bind="_editingPizza.LargePrice" />
                        </div>

                        <div class="col-6 col-lg-3">
                            <label class="form-label fw-semibold">
                                XL Price
                            </label>

                            <input type="number"
                                step="0.01"
                                min="0"
                                class="form-control"
                                @bind="_editingPizza.XLargePrice" />
                        </div>

                        <div class="col-12">
                            <button type="button"
                                    class="btn btn-pizzapp-primary"
                                    @onclick="SaveEditedPizzaAsync"
                                    disabled="@_isSavingPizza">

                                @if (_isSavingPizza)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <i class="bi bi-save me-1"></i>
                                    <span>Save Changes</span>
                                }

                            </button>
                        </div>

                    </div>

                </div>
            }
        </div>
    }

    <!-- 3. Staff Management Section -->
    @if (_activeTab == "staff")
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="h5 fw-bold mb-0">Staff Account Management</h4>
                <button type="button"
                        class="btn btn-sm btn-pizzapp-primary"
                        @onclick="StartAddStaff"
                        disabled="@(_showAddStaffForm ||
                            _isCreatingStaff ||
                            _editingStaff is not null ||
                            _isSavingStaff)">
                    <i class="bi bi-person-plus me-1"></i>
                    Add Staff Member
                </button>
            </div>
            @if (_showAddStaffForm)
            {
                <div class="border rounded-3 p-3 mb-4 bg-light">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold mb-1">
                                Add Staff Member
                            </h5>

                            <p class="text-muted small mb-0">
                                Create a new staff or administrator account.
                            </p>
                        </div>

                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="CancelAddStaff"
                                disabled="@_isCreatingStaff">
                            Cancel
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_addStaffError))
                    {
                        <div class="alert alert-danger"
                            role="alert">
                            @_addStaffError
                        </div>
                    }

                    <div class="row g-3">

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                Full Name
                            </label>

                            <input type="text"
                                class="form-control"
                                @bind="_newStaffFullName"
                                disabled="@_isCreatingStaff" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                Email
                            </label>

                            <input type="email"
                                class="form-control"
                                @bind="_newStaffEmail"
                                disabled="@_isCreatingStaff" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                Role
                            </label>

                            <select class="form-select"
                                    @bind="_newStaffRole"
                                    disabled="@_isCreatingStaff">
                                <option value="Staff">Staff</option>
                                <option value="Administrator">Administrator</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                Initial Password
                            </label>

                            <input type="password"
                                class="form-control"
                                autocomplete="new-password"
                                @bind="_newStaffPassword"
                                disabled="@_isCreatingStaff" />

                            <div class="form-text">
                                Minimum 6 characters.
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                Confirm Password
                            </label>

                            <input type="password"
                                class="form-control"
                                autocomplete="new-password"
                                @bind="_newStaffConfirmPassword"
                                disabled="@_isCreatingStaff" />
                        </div>

                        <div class="col-12">
                            <button type="button"
                                    class="btn btn-pizzapp-primary"
                                    @onclick="CreateStaffAsync"
                                    disabled="@_isCreatingStaff">

                                @if (_isCreatingStaff)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Creating Account...</span>
                                }
                                else
                                {
                                    <i class="bi bi-person-check me-1"></i>
                                    <span>Create Staff Account</span>
                                }

                            </button>
                        </div>

                    </div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_staffSuccess))
            {
                <div class="alert alert-success"
                    role="status">
                    @_staffSuccess
                </div>
            }
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Staff Member</th>
                            <th>Role</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_isLoadingStaff)
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-4">

                                    <div class="spinner-border spinner-border-sm text-danger me-2"
                                        role="status">
                                    </div>

                                    Loading staff accounts...
                                </td>
                            </tr>
                        }
                        else if (!string.IsNullOrWhiteSpace(_staffError))
                        {
                            <tr>
                                <td colspan="5">
                                    <div class="alert alert-danger mb-0"
                                        role="alert">
                                        @_staffError
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (_staffAccounts.Count == 0)
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-4">
                                    No staff accounts found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var staff in _staffAccounts)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @staff.FullName
                                    </td>

                                    <td>
                                        @if (staff.Role == "Administrator")
                                        {
                                            <span class="role-badge role-badge-admin">
                                                Administrator
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="role-badge role-badge-staff">
                                                Staff
                                            </span>
                                        }
                                    </td>

                                    <td class="text-muted">
                                        @staff.Email
                                    </td>

                                    <td>
                                        @if (staff.IsDisabled)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">
                                                Disabled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                Active
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                @onclick="() => StartManageStaff(staff)"
                                                disabled="@(_isSavingStaff || _isCreatingStaff)">
                                            Manage
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (_editingStaff is not null)
            {
                <div class="border-top pt-4 mt-3"
                    @ref="_staffEditPanel"
                    tabindex="-1"
                    style="outline: none;">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold mb-1">
                                Manage Staff Member
                            </h5>

                            <p class="text-muted small mb-0">
                                Update @_editingStaff.FullName's account information.
                            </p>
                        </div>

                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="CancelManageStaff"
                                disabled="@_isSavingStaff">
                            Cancel
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_manageStaffError))
                    {
                        <div class="alert alert-danger"
                            role="alert">
                            @_manageStaffError
                        </div>
                    }

                    <div class="row g-3">

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                Full Name
                            </label>

                            <input type="text"
                                class="form-control"
                                @bind="_editingStaff.FullName"
                                disabled="@_isSavingStaff" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                Email
                            </label>

                            <input type="email"
                                class="form-control"
                                @bind="_editingStaff.Email"
                                disabled="@_isSavingStaff" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                Role
                            </label>

                            <select class="form-select"
                                    @bind="_editingStaff.Role"
                                    disabled="@_isSavingStaff">
                                <option value="Staff">Staff</option>
                                <option value="Administrator">Administrator</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold d-block">
                                Status
                            </label>

                            @if (_editingStaff.IsDisabled)
                            {
                                <span class="badge bg-secondary-subtle text-secondary">
                                    Disabled
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success">
                                    Active
                                </span>
                            }

                            <div class="form-text mb-2">
                                Disabled accounts cannot sign in again until they are re-enabled.
                            </div>

                            <button type="button"
                                    class="@(_editingStaff.IsDisabled
                                        ? "btn btn-outline-success btn-sm"
                                        : "btn btn-outline-danger btn-sm")"
                                    @onclick="ToggleManagedStaffStatusAsync"
                                    disabled="@_isUpdatingStaffStatus">

                                @if (_isUpdatingStaffStatus)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Updating...</span>
                                }
                                else if (_editingStaff.IsDisabled)
                                {
                                    <i class="bi bi-unlock me-1"></i>
                                    <span>Enable Account</span>
                                }
                                else
                                {
                                    <i class="bi bi-lock me-1"></i>
                                    <span>Disable Account</span>
                                }
                            </button>
                        </div>

                        <div class="col-12">
                            <button type="button"
                                    class="btn btn-pizzapp-primary"
                                    @onclick="SaveManagedStaffAsync"
                                    disabled="@_isSavingStaff">

                                @if (_isSavingStaff)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <i class="bi bi-save me-1"></i>
                                    <span>Save Changes</span>
                                }

                            </button>
                        </div>
                        <div class="col-12">
                            <hr class="my-2" />

                            <h6 class="fw-bold mb-3">
                                Set New Password
                            </h6>

                            <p class="text-muted small">
                                Set a new password for this staff account.
                                The existing password cannot be viewed.
                            </p>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                New Password
                            </label>

                            <input type="password"
                                class="form-control"
                                @bind="_managedStaffNewPassword"
                                disabled="@_isResettingStaffPassword" />

                            <div class="form-text">
                                Minimum 6 characters.
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                Confirm New Password
                            </label>

                            <input type="password"
                                class="form-control"
                                @bind="_managedStaffConfirmPassword"
                                disabled="@_isResettingStaffPassword" />
                        </div>

                        <div class="col-12">
                            <button type="button"
                                    class="btn btn-outline-primary"
                                    @onclick="ResetManagedStaffPasswordAsync"
                                    disabled="@_isResettingStaffPassword">

                                @if (_isResettingStaffPassword)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Setting Password...</span>
                                }
                                else
                                {
                                    <i class="bi bi-key me-1"></i>
                                    <span>Set New Password</span>
                                }

                            </button>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_manageStaffSuccess))
                        {
                            <div class="col-12">
                                <div class="alert alert-success mb-0"
                                    role="alert">
                                    <i class="bi bi-check-circle-fill me-2"></i>
                                    @_manageStaffSuccess
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <!-- 4. Store Settings Section -->
    @if (_activeTab == "settings")
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <h4 class="h5 fw-bold mb-3">Store & Ordering Configuration</h4>

            @if (_isLoadingSettings)
            {
                <div class="text-muted">
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    Loading store settings...
                </div>
            }
