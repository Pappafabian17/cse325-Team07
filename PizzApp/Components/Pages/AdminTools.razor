    private async Task LoadStaffAccountsAsync()
    {
        _isLoadingStaff = true;
        _staffError = string.Empty;

        try
        {
            await using var scope =
                ScopeFactory.CreateAsyncScope();

            var userManager =
                scope.ServiceProvider
                    .GetRequiredService<UserManager<ApplicationUser>>();

            var administrators =
                await userManager.GetUsersInRoleAsync("Administrator");

            var staffUsers =
                await userManager.GetUsersInRoleAsync("Staff");

            var accounts =
                new List<StaffAccountViewModel>();

            foreach (var user in administrators)
            {
                accounts.Add(new StaffAccountViewModel
                {
                    Id = user.Id,
                    FullName = user.FullName,
                    Email = user.Email ?? user.UserName ?? string.Empty,
                    Role = "Administrator",
                    IsDisabled =
                        await userManager.IsLockedOutAsync(user)
                });
            }

            foreach (var user in staffUsers)
            {
                // Avoid showing the same account twice if somebody
                // accidentally belongs to both roles.
                if (accounts.Any(account => account.Id == user.Id))
                {
                    continue;
                }

                accounts.Add(new StaffAccountViewModel
                {
                    Id = user.Id,
                    FullName = user.FullName,
                    Email = user.Email ?? user.UserName ?? string.Empty,
                    Role = "Staff",
                    IsDisabled =
                        await userManager.IsLockedOutAsync(user)
                });
            }

            _staffAccounts = accounts
                .OrderByDescending(account =>
                    account.Role == "Administrator")
                .ThenBy(account => account.FullName)
                .ToList();
        }
        catch
        {
            _staffError =
                "We couldn't load the staff accounts. Please try again.";
        }
        finally
        {
            _isLoadingStaff = false;
        }
