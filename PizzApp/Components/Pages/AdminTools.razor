@page "/admin"
@page "/admin/tools"
@attribute [Authorize(Roles = "Administrator")]

@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using PizzApp.Data
@using PizzApp.Models

@inject IDbContextFactory<PizzAppDbContext> DbFactory
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Admin Tools - PizzApp</PageTitle>

<div class="container-xl py-4 py-md-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="role-badge role-badge-admin">Admin Portal</span>
                <span class="text-muted small">&bull; Store Administration</span>
            </div>
            <h1 class="h2 fw-bold mb-0">Administrator Tools & Controls</h1>
        </div>
        <div>
            <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">
                <i class="bi bi-shield-check me-1"></i> Admin Privileges Active
            </span>
        </div>
    </div>


    <!-- Navigation Pills / Section Selector -->
    <ul class="nav nav-pills mb-4 gap-2" id="adminTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeTab == "sales" ? "active" : "")" 
                    @onclick='() => _activeTab = "sales"'>
                <i class="bi bi-graph-up-arrow me-1"></i> Sales Summary
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeTab == "menu" ? "active" : "")" 
                    @onclick='() => _activeTab = "menu"'>
                <i class="bi bi-card-list me-1"></i> Menu Controls
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeTab == "staff" ? "active" : "")" 
                    @onclick='() => _activeTab = "staff"'>
                <i class="bi bi-people me-1"></i> Staff Management
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeTab == "settings" ? "active" : "")" 
                    @onclick='() => _activeTab = "settings"'>
                <i class="bi bi-sliders me-1"></i> Store Settings
            </button>
        </li>
    </ul>

    <!-- 1. Sales Summary Section -->
    @if (_activeTab == "sales")
    {
        @if (_isLoadingSales)
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center">
                <div class="spinner-border text-danger mx-auto mb-3"
                    role="status">
                </div>

                <p class="text-muted mb-0">
                    Loading sales summary...
                </p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_salesError))
        {
            <div class="alert alert-danger" role="alert">
                @_salesError
            </div>
        }
        else
        {
            <div class="row g-4 mb-4">

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <span class="text-muted small fw-semibold text-uppercase">
                            Today's Revenue
                        </span>

                        <span class="fs-2 fw-bold text-dark mt-2">
                            $@_todayRevenue.ToString("N2")
                        </span>

                        <span class="text-muted small mt-1">
                            From @_todayOrderCount order@(_todayOrderCount == 1 ? "" : "s")
                        </span>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <span class="text-muted small fw-semibold text-uppercase">
                            Orders Placed
                        </span>

                        <span class="fs-2 fw-bold text-dark mt-2">
                            @_todayOrderCount
                        </span>

                        <span class="text-muted small mt-1">
                            @_activeOrderCount active currently
                        </span>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <span class="text-muted small fw-semibold text-uppercase">
                            Average Ticket
                        </span>

                        <span class="fs-2 fw-bold text-dark mt-2">
                            $@_averageTicket.ToString("N2")
                        </span>

                        <span class="text-muted small mt-1">
                            @_averageItemsPerOrder.ToString("0.0") items / order
                        </span>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <span class="text-muted small fw-semibold text-uppercase">
                            Top Pizza
                        </span>

                        <span class="fs-2 fw-bold text-danger mt-2">
                            @_topPizzaName
                        </span>

                        <span class="text-muted small mt-1">
                            @_topPizzaDetail
                        </span>
                    </div>
                </div>

            </div>
        }
    }

    <!-- 2. Menu Controls Section -->
    @if (_activeTab == "menu")
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="h5 fw-bold mb-0">Menu & Specialty Pizzas Control</h4>
            </div>
            <div class="table-responsive">
                @if (!string.IsNullOrWhiteSpace(_menuError))
                {
                    <div class="alert alert-danger mb-3"
                        role="alert">
                        @_menuError
                    </div>
                }
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Pizza Name</th>
                            <th>Starting Price</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_isLoadingMenu)
                        {
                            <tr>
                                <td colspan="4"
                                    class="text-center text-muted py-4">

                                    <div class="spinner-border spinner-border-sm text-danger me-2"
                                        role="status">
                                    </div>

                                    Loading menu...
                                </td>
                            </tr>
                        }
                        else if (_specialtyPizzas.Count == 0)
                        {
                            <tr>
                                <td colspan="4"
                                    class="text-center text-muted py-4">
                                    No specialty pizzas found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var pizza in _specialtyPizzas)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @pizza.Name Pizza
                                    </td>

                                    <td>
                                        $@pizza.SmallPrice.ToString("0.00")
                                    </td>

                                    <td>
                                        @if (pizza.IsAvailable)
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">
                                                Unavailable
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">

                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary me-2"
                                                @onclick="() => StartEditPizza(pizza)"
                                                disabled="@_isSavingPizza">
                                            Edit
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm @(pizza.IsAvailable
                                                    ? "btn-outline-danger"
                                                    : "btn-outline-success")"
                                                @onclick="() => TogglePizzaAvailabilityAsync(pizza)"
                                                disabled="@_updatingPizzaIds.Contains(pizza.Id)">

                                            @if (_updatingPizzaIds.Contains(pizza.Id))
                                            {
                                                <span class="spinner-border spinner-border-sm"></span>
                                            }
                                            else if (pizza.IsAvailable)
                                            {
                                                <span>Disable</span>
                                            }
                                            else
                                            {
                                                <span>Enable</span>
                                            }

                                        </button>

                                    </td>

                                </tr>
                            }

                        }
                    </tbody>
                </table>
            </div>
            @if (_editingPizza is not null)
            {
                <div class="border-top pt-4 mt-3"
                    @ref="_editPanel"
                    tabindex="-1"
                    style="outline: none;">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold mb-1">
                                Edit Specialty Pizza
                            </h5>

                            <p class="text-muted small mb-0">
                                Update the menu details and prices for @_editingPizza.Name.
                            </p>
                        </div>

                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="CancelEditPizza"
                                disabled="@_isSavingPizza">
                            Cancel
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_editPizzaError))
                    {
                        <div class="alert alert-danger"
                            role="alert">
                            @_editPizzaError
                        </div>
                    }

                    <div class="row g-3">

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                Pizza Name
                            </label>

                            <input type="text"
                                class="form-control"
                                @bind="_editingPizza.Name" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">
                                Image Path
                            </label>

                            <input type="text"
                                class="form-control"
                                @bind="_editingPizza.ImagePath" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea class="form-control"
                                    rows="3"
                                    @bind="_editingPizza.Description">
                            </textarea>
                        </div>

                        <div class="col-6 col-lg-3">
                            <label class="form-label fw-semibold">
                                Small Price
                            </label>

                            <input type="number"
                                step="0.01"
                                min="0"
                                class="form-control"
                                @bind="_editingPizza.SmallPrice" />
                        </div>

                        <div class="col-6 col-lg-3">
                            <label class="form-label fw-semibold">
                                Medium Price
                            </label>

                            <input type="number"
                                step="0.01"
                                min="0"
                                class="form-control"
                                @bind="_editingPizza.MediumPrice" />
                        </div>

                        <div class="col-6 col-lg-3">
                            <label class="form-label fw-semibold">
                                Large Price
                            </label>

                            <input type="number"
                                step="0.01"
                                min="0"
                                class="form-control"
                                @bind="_editingPizza.LargePrice" />
                        </div>

                        <div class="col-6 col-lg-3">
                            <label class="form-label fw-semibold">
                                XL Price
                            </label>

                            <input type="number"
                                step="0.01"
                                min="0"
                                class="form-control"
                                @bind="_editingPizza.XLargePrice" />
                        </div>

                        <div class="col-12">
                            <button type="button"
                                    class="btn btn-pizzapp-primary"
                                    @onclick="SaveEditedPizzaAsync"
                                    disabled="@_isSavingPizza">

                                @if (_isSavingPizza)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <i class="bi bi-save me-1"></i>
                                    <span>Save Changes</span>
                                }

                            </button>
                        </div>

                    </div>

                </div>
            }
        </div>
    }

    <!-- 3. Staff Management Section -->
    @if (_activeTab == "staff")
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="h5 fw-bold mb-0">Staff Account Management</h4>
                <button class="btn btn-sm btn-pizzapp-primary">
                    <i class="bi bi-person-plus me-1"></i> Add Staff Member
                </button>
            </div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Staff Member</th>
                            <th>Role</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_isLoadingStaff)
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-4">

                                    <div class="spinner-border spinner-border-sm text-danger me-2"
                                        role="status">
                                    </div>

                                    Loading staff accounts...
                                </td>
                            </tr>
                        }
                        else if (!string.IsNullOrWhiteSpace(_staffError))
                        {
                            <tr>
                                <td colspan="5">
                                    <div class="alert alert-danger mb-0"
                                        role="alert">
                                        @_staffError
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (_staffAccounts.Count == 0)
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-4">
                                    No staff accounts found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var staff in _staffAccounts)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @staff.FullName
                                    </td>

                                    <td>
                                        @if (staff.Role == "Administrator")
                                        {
                                            <span class="role-badge role-badge-admin">
                                                Administrator
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="role-badge role-badge-staff">
                                                Staff
                                            </span>
                                        }
                                    </td>

                                    <td class="text-muted">
                                        @staff.Email
                                    </td>

                                    <td>
                                        @if (staff.IsDisabled)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">
                                                Disabled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                Active
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                disabled>
                                            Manage
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- 4. Store Settings Section -->
    @if (_activeTab == "settings")
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <h4 class="h5 fw-bold mb-3">Store & Ordering Configuration</h4>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label small fw-semibold text-dark">Store Operating Hours</label>
                    <input type="text" class="form-control" value="11:00 AM – 10:00 PM Daily" />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label small fw-semibold text-dark">Delivery Radius (Miles)</label>
                    <input type="number" class="form-control" value="8" />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label small fw-semibold text-dark">Standard Delivery Fee ($)</label>
                    <input type="text" class="form-control" value="3.50" />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label small fw-semibold text-dark">Sales Tax Rate (%)</label>
                    <input type="text" class="form-control" value="6.0" />
                </div>
                <div class="col-12 mt-3">
                    <button class="btn btn-pizzapp-primary">Save Settings</button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .nav-pills .nav-link {
        color: #2B2926;
        font-weight: 600;
        border-radius: 0.5rem;
        background-color: #ffffff;
        border: 1px solid #EADBCE;
    }
    .nav-pills .nav-link.active {
        background-color: #C83A2A;
        border-color: #C83A2A;
        color: #ffffff;
    }
</style>

@code {
    private string _activeTab = "sales";

    private bool _isLoadingSales = true;

    private string _salesError = string.Empty;

    private decimal _todayRevenue;

    private int _todayOrderCount;

    private int _activeOrderCount;

    private decimal _averageTicket;

    private decimal _averageItemsPerOrder;

    private string _topPizzaName = "—";

    private string _topPizzaDetail = "No sales today";

    private List<StaffAccountViewModel> _staffAccounts = new();

    private bool _isLoadingStaff;

    private string _staffError = string.Empty;

    private List<SpecialtyPizza> _specialtyPizzas = new();

    private bool _isLoadingMenu;

    private string _menuError = string.Empty;

    private ElementReference _editPanel;

    private bool _scrollToEditPanel;

    private SpecialtyPizza? _editingPizza;

    private bool _isSavingPizza;

    private string _editPizzaError = string.Empty;

    private readonly HashSet<int> _updatingPizzaIds = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSalesSummaryAsync();
        await LoadMenuAsync();
        await LoadStaffAccountsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollToEditPanel && _editingPizza is not null)
        {
            _scrollToEditPanel = false;
            await _editPanel.FocusAsync();
        }
    }

    private async Task LoadSalesSummaryAsync()
    {
        _isLoadingSales = true;
        _salesError = string.Empty;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            var storeTimeZone =
                TimeZoneInfo.FindSystemTimeZoneById("America/Boise");

            var storeNow =
                TimeZoneInfo.ConvertTime(
                    DateTimeOffset.UtcNow,
                    storeTimeZone);

            var storeToday =
                storeNow.Date;

            var todayStart =
                TimeZoneInfo.ConvertTimeToUtc(
                    storeToday,
                    storeTimeZone);

            var tomorrowStart =
                TimeZoneInfo.ConvertTimeToUtc(
                    storeToday.AddDays(1),
                    storeTimeZone);

            var todayOrders = await db.Orders
                .AsNoTracking()
                .Include(order => order.Items)
                .Where(order =>
                    order.PlacedAt >= todayStart &&
                    order.PlacedAt < tomorrowStart &&
                    order.Status != OrderStatus.Cancelled)
                .ToListAsync();

            _todayOrderCount =
                todayOrders.Count;

            _todayRevenue =
                todayOrders.Sum(order => order.Total);

            _averageTicket =
                _todayOrderCount > 0
                    ? _todayRevenue / _todayOrderCount
                    : 0m;

            var totalItems =
                todayOrders
                    .SelectMany(order => order.Items)
                    .Sum(item => item.Quantity);

            _averageItemsPerOrder =
                _todayOrderCount > 0
                    ? (decimal)totalItems / _todayOrderCount
                    : 0m;

            _activeOrderCount =
                await db.Orders.CountAsync(order =>
                    order.Status != OrderStatus.Completed &&
                    order.Status != OrderStatus.Cancelled);

            var pizzaSales =
                todayOrders
                    .SelectMany(order => order.Items)
                    .GroupBy(item => item.PizzaName)
                    .Select(group => new
                    {
                        Name = group.Key,
                        Quantity = group.Sum(item => item.Quantity)
                    })
                    .OrderByDescending(item => item.Quantity)
                    .ThenBy(item => item.Name)
                    .ToList();

            if (pizzaSales.Count > 0)
            {
                var topQuantity =
                    pizzaSales[0].Quantity;

                var topPizzas =
                    pizzaSales
                        .Where(item => item.Quantity == topQuantity)
                        .ToList();

                if (topPizzas.Count == 1)
                {
                    _topPizzaName =
                        topPizzas[0].Name;

                    _topPizzaDetail =
                        $"{topQuantity} sold today";
                }
                else
                {
                    _topPizzaName =
                        $"{topPizzas.Count}-way tie";

                    _topPizzaDetail =
                        $"{topQuantity} each today";
                }
            }
            else
            {
                _topPizzaName = "—";
                _topPizzaDetail = "No sales today";
            }
        }
        catch
        {
            _salesError =
                "We couldn't load the sales summary. Please try again.";
        }
        finally
        {
            _isLoadingSales = false;
        }
    }

    private async Task LoadMenuAsync()
    {
        _isLoadingMenu = true;
        _menuError = string.Empty;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            _specialtyPizzas = await db.SpecialtyPizzas
                .AsNoTracking()
                .OrderBy(pizza => pizza.Name)
                .ToListAsync();
        }
        catch
        {
            _menuError =
                "We couldn't load the menu. Please try again.";
        }
        finally
        {
            _isLoadingMenu = false;
        }
    }

    private async Task LoadStaffAccountsAsync()
    {
        _isLoadingStaff = true;
        _staffError = string.Empty;

        try
        {
            await using var scope =
                ScopeFactory.CreateAsyncScope();

            var userManager =
                scope.ServiceProvider
                    .GetRequiredService<UserManager<ApplicationUser>>();

            var administrators =
                await userManager.GetUsersInRoleAsync("Administrator");

            var staffUsers =
                await userManager.GetUsersInRoleAsync("Staff");

            var accounts =
                new List<StaffAccountViewModel>();

            foreach (var user in administrators)
            {
                accounts.Add(new StaffAccountViewModel
                {
                    Id = user.Id,
                    FullName = user.FullName,
                    Email = user.Email ?? user.UserName ?? string.Empty,
                    Role = "Administrator",
                    IsDisabled =
                        await userManager.IsLockedOutAsync(user)
                });
            }

            foreach (var user in staffUsers)
            {
                // Avoid showing the same account twice if somebody
                // accidentally belongs to both roles.
                if (accounts.Any(account => account.Id == user.Id))
                {
                    continue;
                }

                accounts.Add(new StaffAccountViewModel
                {
                    Id = user.Id,
                    FullName = user.FullName,
                    Email = user.Email ?? user.UserName ?? string.Empty,
                    Role = "Staff",
                    IsDisabled =
                        await userManager.IsLockedOutAsync(user)
                });
            }

            _staffAccounts = accounts
                .OrderByDescending(account =>
                    account.Role == "Administrator")
                .ThenBy(account => account.FullName)
                .ToList();
        }
        catch
        {
            _staffError =
                "We couldn't load the staff accounts. Please try again.";
        }
        finally
        {
            _isLoadingStaff = false;
        }
    }

    private void StartEditPizza(SpecialtyPizza pizza)
    {
        _editPizzaError = string.Empty;

        _editingPizza = new SpecialtyPizza
        {
            Id = pizza.Id,
            Name = pizza.Name,
            Description = pizza.Description,
            ImagePath = pizza.ImagePath,
            SmallPrice = pizza.SmallPrice,
            MediumPrice = pizza.MediumPrice,
            LargePrice = pizza.LargePrice,
            XLargePrice = pizza.XLargePrice,
            IsAvailable = pizza.IsAvailable
        };

        _scrollToEditPanel = true;
    }

    private void CancelEditPizza()
    {
        if (_isSavingPizza)
        {
            return;
        }

        _editingPizza = null;
        _editPizzaError = string.Empty;
    }

    private async Task SaveEditedPizzaAsync()
    {
        if (_editingPizza is null ||
            _isSavingPizza)
        {
            return;
        }

        _editPizzaError = string.Empty;

        if (string.IsNullOrWhiteSpace(_editingPizza.Name))
        {
            _editPizzaError =
                "Pizza name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_editingPizza.Description))
        {
            _editPizzaError =
                "Description is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_editingPizza.ImagePath))
        {
            _editPizzaError =
                "Image path is required.";
            return;
        }

        if (_editingPizza.SmallPrice <= 0 ||
            _editingPizza.MediumPrice <= 0 ||
            _editingPizza.LargePrice <= 0 ||
            _editingPizza.XLargePrice <= 0)
        {
            _editPizzaError =
                "All pizza prices must be greater than zero.";
            return;
        }

        _isSavingPizza = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            var databasePizza =
                await db.SpecialtyPizzas
                    .FirstOrDefaultAsync(
                        pizza => pizza.Id == _editingPizza.Id);

            if (databasePizza is null)
            {
                _editPizzaError =
                    "That pizza could not be found.";
                return;
            }

            databasePizza.Name =
                _editingPizza.Name.Trim();

            databasePizza.Description =
                _editingPizza.Description.Trim();

            databasePizza.ImagePath =
                _editingPizza.ImagePath.Trim();

            databasePizza.SmallPrice =
                _editingPizza.SmallPrice;

            databasePizza.MediumPrice =
                _editingPizza.MediumPrice;

            databasePizza.LargePrice =
                _editingPizza.LargePrice;

            databasePizza.XLargePrice =
                _editingPizza.XLargePrice;

            await db.SaveChangesAsync();

            _editingPizza = null;

            await LoadMenuAsync();
        }
        catch (DbUpdateException)
        {
            _editPizzaError =
                "The pizza could not be saved. Make sure the name is unique and try again.";
        }
        catch
        {
            _editPizzaError =
                "We couldn't save the pizza changes. Please try again.";
        }
        finally
        {
            _isSavingPizza = false;
        }
    }

    private async Task TogglePizzaAvailabilityAsync(
        SpecialtyPizza pizza)
    {
        if (!_updatingPizzaIds.Add(pizza.Id))
        {
            return;
        }

        _menuError = string.Empty;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            var databasePizza =
                await db.SpecialtyPizzas
                    .FirstOrDefaultAsync(
                        item => item.Id == pizza.Id);

            if (databasePizza is null)
            {
                _menuError =
                    "That pizza could not be found.";

                return;
            }

            databasePizza.IsAvailable =
                !databasePizza.IsAvailable;

            await db.SaveChangesAsync();

            await LoadMenuAsync();
        }
        catch
        {
            _menuError =
                $"We couldn't update {pizza.Name}. Please try again.";
        }
        finally
        {
            _updatingPizzaIds.Remove(pizza.Id);
        }
    }

