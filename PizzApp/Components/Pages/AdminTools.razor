    private async Task SaveManagedStaffAsync()
    {
        if (_editingStaff is null ||
            _isSavingStaff)
        {
            return;
        }

        _manageStaffError = string.Empty;
        _staffSuccess = string.Empty;

        var fullName =
            _editingStaff.FullName.Trim();

        var email =
            _editingStaff.Email.Trim();

        var requestedRole =
            _editingStaff.Role;

        if (string.IsNullOrWhiteSpace(fullName))
        {
            _manageStaffError =
                "Full name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(email) ||
            !email.Contains('@'))
        {
            _manageStaffError =
                "Enter a valid email address.";
            return;
        }

        if (requestedRole != "Staff" &&
            requestedRole != "Administrator")
        {
            _manageStaffError =
                "Select a valid staff role.";
            return;
        }

        _isSavingStaff = true;

        try
        {
            await using var scope =
                ScopeFactory.CreateAsyncScope();

            var userManager =
                scope.ServiceProvider
                    .GetRequiredService<UserManager<ApplicationUser>>();

            var user =
                await userManager.FindByIdAsync(
                    _editingStaff.Id);

            if (user is null)
            {
                _manageStaffError =
                    "That staff account could not be found.";
                return;
            }

            var existingEmailUser =
                await userManager.FindByEmailAsync(email);

            if (existingEmailUser is not null &&
                existingEmailUser.Id != user.Id)
            {
                _manageStaffError =
                    "Another account already uses that email address.";
                return;
            }

            var roles =
                await userManager.GetRolesAsync(user);

            var currentRole =
                roles.Contains("Administrator")
                    ? "Administrator"
                    : roles.Contains("Staff")
                        ? "Staff"
                        : string.Empty;

            if (string.IsNullOrWhiteSpace(currentRole))
            {
                _manageStaffError =
                    "This account does not have a valid staff role.";
                return;
            }

            // Never allow the last Administrator to be demoted.
            if (currentRole == "Administrator" &&
                requestedRole == "Staff")
            {
                var administrators =
                    await userManager.GetUsersInRoleAsync(
                        "Administrator");

                var hasOtherActiveAdministrator = false;

                foreach (var administrator in administrators)
                {
                    if (administrator.Id == user.Id)
                    {
                        continue;
                    }

                    if (!await userManager.IsLockedOutAsync(
                            administrator))
                    {
                        hasOtherActiveAdministrator = true;
                        break;
                    }
                }

                if (!hasOtherActiveAdministrator)
                {
                    _manageStaffError =
                        "The last active Administrator cannot be changed to Staff.";
                    return;
                }
            }

            user.FullName = fullName;
            user.Email = email;
            user.UserName = email;

            var updateResult =
                await userManager.UpdateAsync(user);

            if (!updateResult.Succeeded)
            {
                _manageStaffError =
                    string.Join(
                        " ",
                        updateResult.Errors
                            .Select(error => error.Description));

                return;
            }

            if (currentRole != requestedRole)
            {
                var addRoleResult =
                    await userManager.AddToRoleAsync(
                        user,
                        requestedRole);

                if (!addRoleResult.Succeeded)
                {
                    _manageStaffError =
                        string.Join(
                            " ",
                            addRoleResult.Errors
                                .Select(error => error.Description));

                    return;
                }

                var removeRoleResult =
                    await userManager.RemoveFromRoleAsync(
                        user,
                        currentRole);

                if (!removeRoleResult.Succeeded)
                {
                    // Roll back the newly added role if the old role
                    // could not be removed.
                    await userManager.RemoveFromRoleAsync(
                        user,
                        requestedRole);

                    _manageStaffError =
                        string.Join(
                            " ",
                            removeRoleResult.Errors
                                .Select(error => error.Description));

                    return;
                }
            }

            _editingStaff = null;

            await LoadStaffAccountsAsync();

            _staffSuccess =
                $"{fullName} was updated successfully.";
        }
        catch
        {
            _manageStaffError =
                "We couldn't update the staff account. Please try again.";
        }
        finally
        {
            _isSavingStaff = false;
        }
    }

    private async Task ResetManagedStaffPasswordAsync()
    {
        if (_editingStaff is null ||
            _isResettingStaffPassword)
        {
            return;
        }

        _manageStaffError = string.Empty;
        _manageStaffSuccess = string.Empty;

        if (string.IsNullOrWhiteSpace(
                _managedStaffNewPassword))
        {
            _manageStaffError =
                "Enter a new password.";
            return;
        }

        if (_managedStaffNewPassword.Length < 6)
        {
            _manageStaffError =
                "The new password must be at least 6 characters.";
            return;
        }

        if (_managedStaffNewPassword !=
            _managedStaffConfirmPassword)
        {
            _manageStaffError =
                "The password confirmation does not match.";
            return;
        }

        _isResettingStaffPassword = true;

        try
        {
            await using var scope =
                ScopeFactory.CreateAsyncScope();

            var userManager =
                scope.ServiceProvider
                    .GetRequiredService<UserManager<ApplicationUser>>();

            var user =
                await userManager.FindByIdAsync(
                    _editingStaff.Id);

            if (user is null)
            {
                _manageStaffError =
                    "That staff account could not be found.";
                return;
            }

            var resetToken =
                await userManager
                    .GeneratePasswordResetTokenAsync(user);

            var resetResult =
                await userManager.ResetPasswordAsync(
                    user,
                    resetToken,
                    _managedStaffNewPassword);

            if (!resetResult.Succeeded)
            {
                _manageStaffError =
                    string.Join(
                        " ",
                        resetResult.Errors
                            .Select(error => error.Description));

                return;
            }

            _managedStaffNewPassword =
                string.Empty;

            _managedStaffConfirmPassword =
                string.Empty;

            _manageStaffSuccess =
                $"A new password was set for {_editingStaff.FullName}.";
        }
        catch
        {
            _manageStaffError =
                "We couldn't set the new password. Please try again.";
        }
        finally
        {
            _isResettingStaffPassword = false;
        }
    }

    private async Task ToggleManagedStaffStatusAsync()
    {
        if (_editingStaff is null ||
            _isUpdatingStaffStatus)
        {
            return;
        }

        _manageStaffError = string.Empty;
        _manageStaffSuccess = string.Empty;
        _isUpdatingStaffStatus = true;

        try
        {
            await using var scope =
                ScopeFactory.CreateAsyncScope();

            var userManager =
                scope.ServiceProvider
                    .GetRequiredService<UserManager<ApplicationUser>>();

            var user =
                await userManager.FindByIdAsync(
                    _editingStaff.Id);

            if (user is null)
            {
                _manageStaffError =
                    "That staff account could not be found.";
                return;
            }

            var isCurrentlyDisabled =
                await userManager.IsLockedOutAsync(user);

            if (isCurrentlyDisabled)
            {
                var enableResult =
                    await userManager.SetLockoutEndDateAsync(
                        user,
                        null);

                if (!enableResult.Succeeded)
                {
                    _manageStaffError =
                        string.Join(
                            " ",
                            enableResult.Errors
                                .Select(error => error.Description));

                    return;
                }

                _editingStaff.IsDisabled = false;

                _manageStaffSuccess =
                    $"{_editingStaff.FullName} has been enabled.";
            }
            else
            {
                var authState =
                    await AuthenticationStateProvider
                        .GetAuthenticationStateAsync();

                var currentUserId =
                    authState.User.FindFirstValue(
                        ClaimTypes.NameIdentifier);

                if (user.Id == currentUserId)
                {
                    _manageStaffError =
                        "You cannot disable your own account.";
                    return;
                }

                var isAdministrator =
                    await userManager.IsInRoleAsync(
                        user,
                        "Administrator");

                if (isAdministrator)
                {
                    var administrators =
                        await userManager.GetUsersInRoleAsync(
                            "Administrator");

                    var hasOtherActiveAdministrator = false;

                    foreach (var administrator in administrators)
                    {
                        if (administrator.Id == user.Id)
                        {
                            continue;
                        }

                        if (!await userManager.IsLockedOutAsync(
                                administrator))
                        {
                            hasOtherActiveAdministrator = true;
                            break;
                        }
                    }

                    if (!hasOtherActiveAdministrator)
                    {
                        _manageStaffError =
                            "The last active Administrator cannot be disabled.";
                        return;
                    }
                }

                var lockoutEnabledResult =
                    await userManager.SetLockoutEnabledAsync(
                        user,
                        true);

                if (!lockoutEnabledResult.Succeeded)
                {
                    _manageStaffError =
                        string.Join(
                            " ",
                            lockoutEnabledResult.Errors
                                .Select(error => error.Description));

                    return;
                }

                var disableResult =
                    await userManager.SetLockoutEndDateAsync(
                        user,
                        DateTimeOffset.UtcNow.AddYears(100));

                if (!disableResult.Succeeded)
                {
                    _manageStaffError =
                        string.Join(
                            " ",
                            disableResult.Errors
                                .Select(error => error.Description));

                    return;
                }

                _editingStaff.IsDisabled = true;

                _manageStaffSuccess =
                    $"{_editingStaff.FullName} has been disabled.";
            }

            await LoadStaffAccountsAsync();
        }
        catch
        {
            _manageStaffError =
                "We couldn't update that account's status. Please try again.";
        }
        finally
        {
            _isUpdatingStaffStatus = false;
        }
    }

    private void StartEditPizza(SpecialtyPizza pizza)
    {
        _editPizzaError = string.Empty;

        _editingPizza = new SpecialtyPizza
        {
            Id = pizza.Id,
            Name = pizza.Name,
            Description = pizza.Description,
            ImagePath = pizza.ImagePath,
            SmallPrice = pizza.SmallPrice,
            MediumPrice = pizza.MediumPrice,
            LargePrice = pizza.LargePrice,
            XLargePrice = pizza.XLargePrice,
            IsAvailable = pizza.IsAvailable
        };

        _scrollToEditPanel = true;
    }

    private void CancelEditPizza()
    {
        if (_isSavingPizza)
        {
            return;
        }

        _editingPizza = null;
        _editPizzaError = string.Empty;
    }

    private async Task SaveEditedPizzaAsync()
    {
        if (_editingPizza is null ||
            _isSavingPizza)
        {
            return;
        }

        _editPizzaError = string.Empty;

        if (string.IsNullOrWhiteSpace(_editingPizza.Name))
        {
            _editPizzaError =
                "Pizza name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_editingPizza.Description))
        {
            _editPizzaError =
                "Description is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_editingPizza.ImagePath))
        {
            _editPizzaError =
                "Image path is required.";
            return;
        }

        if (_editingPizza.SmallPrice <= 0 ||
            _editingPizza.MediumPrice <= 0 ||
            _editingPizza.LargePrice <= 0 ||
            _editingPizza.XLargePrice <= 0)
        {
            _editPizzaError =
                "All pizza prices must be greater than zero.";
            return;
        }

        _isSavingPizza = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            var databasePizza =
                await db.SpecialtyPizzas
                    .FirstOrDefaultAsync(
                        pizza => pizza.Id == _editingPizza.Id);

            if (databasePizza is null)
            {
                _editPizzaError =
                    "That pizza could not be found.";
                return;
            }

            databasePizza.Name =
                _editingPizza.Name.Trim();

            databasePizza.Description =
                _editingPizza.Description.Trim();

            databasePizza.ImagePath =
                _editingPizza.ImagePath.Trim();

            databasePizza.SmallPrice =
                _editingPizza.SmallPrice;

            databasePizza.MediumPrice =
                _editingPizza.MediumPrice;

            databasePizza.LargePrice =
                _editingPizza.LargePrice;

            databasePizza.XLargePrice =
                _editingPizza.XLargePrice;

            await db.SaveChangesAsync();

            _editingPizza = null;

            await LoadMenuAsync();
        }
        catch (DbUpdateException)
        {
            _editPizzaError =
                "The pizza could not be saved. Make sure the name is unique and try again.";
        }
        catch
        {
            _editPizzaError =
                "We couldn't save the pizza changes. Please try again.";
        }
        finally
        {
            _isSavingPizza = false;
        }
    }

    private async Task TogglePizzaAvailabilityAsync(
        SpecialtyPizza pizza)
    {
        if (!_updatingPizzaIds.Add(pizza.Id))
        {
            return;
        }

        _menuError = string.Empty;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            var databasePizza =
                await db.SpecialtyPizzas
                    .FirstOrDefaultAsync(
                        item => item.Id == pizza.Id);

            if (databasePizza is null)
            {
                _menuError =
                    "That pizza could not be found.";

                return;
            }

            databasePizza.IsAvailable =
                !databasePizza.IsAvailable;

            await db.SaveChangesAsync();

            await LoadMenuAsync();
        }
        catch
        {
            _menuError =
                $"We couldn't update {pizza.Name}. Please try again.";
        }
        finally
        {
            _updatingPizzaIds.Remove(pizza.Id);
        }
    }

