    private async Task SaveStoreSettingsAsync()
    {
        if (_storeSettings is null)
        {
            return;
        }

        _settingsError = string.Empty;
        _settingsSuccess = string.Empty;

        var operatingHours =
            _storeSettings.OperatingHours?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(operatingHours))
        {
            _settingsError =
                "Store operating hours are required.";
            return;
        }

        if (_storeSettings.DeliveryRadiusMiles < 1 ||
            _storeSettings.DeliveryRadiusMiles > 100)
        {
            _settingsError =
                "Delivery radius must be between 1 and 100 miles.";
            return;
        }

        if (_storeSettings.DeliveryFee < 0 ||
            _storeSettings.DeliveryFee > 100)
        {
            _settingsError =
                "Delivery fee must be between $0.00 and $100.00.";
            return;
        }

        if (_storeSettings.SalesTaxPercent < 0 ||
            _storeSettings.SalesTaxPercent > 100)
        {
            _settingsError =
                "Sales tax rate must be between 0% and 100%.";
            return;
        }

        _isSavingSettings = true;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            var settings =
                await db.StoreSettings
                    .SingleOrDefaultAsync(
                        item => item.Id == _storeSettings.Id);

            if (settings is null)
            {
                _settingsError =
                    "Store settings could not be found.";
                return;
            }

            settings.OperatingHours = operatingHours;
            settings.DeliveryRadiusMiles =
                _storeSettings.DeliveryRadiusMiles;
            settings.DeliveryFee =
                _storeSettings.DeliveryFee;
            settings.SalesTaxPercent =
                _storeSettings.SalesTaxPercent;

            await db.SaveChangesAsync();

            _storeSettings.OperatingHours =
                operatingHours;

            _settingsSuccess =
                "Store settings saved successfully.";
