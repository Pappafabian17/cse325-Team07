    private async Task LoadSalesSummaryAsync()
    {
        _isLoadingSales = true;
        _salesError = string.Empty;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            var storeTimeZone =
                TimeZoneInfo.FindSystemTimeZoneById("America/Boise");

            var storeNow =
                TimeZoneInfo.ConvertTime(
                    DateTimeOffset.UtcNow,
                    storeTimeZone);

            var storeToday =
                storeNow.Date;

            var todayStart =
                TimeZoneInfo.ConvertTimeToUtc(
                    storeToday,
                    storeTimeZone);

            var tomorrowStart =
                TimeZoneInfo.ConvertTimeToUtc(
                    storeToday.AddDays(1),
                    storeTimeZone);

            var todayOrders = await db.Orders
                .AsNoTracking()
                .Include(order => order.Items)
                .Where(order =>
                    order.PlacedAt >= todayStart &&
                    order.PlacedAt < tomorrowStart &&
                    order.Status != OrderStatus.Cancelled)
                .ToListAsync();

            _todayOrderCount =
                todayOrders.Count;

            _todayRevenue =
                todayOrders.Sum(order => order.Total);

            _averageTicket =
                _todayOrderCount > 0
                    ? _todayRevenue / _todayOrderCount
                    : 0m;

            var totalItems =
                todayOrders
                    .SelectMany(order => order.Items)
                    .Sum(item => item.Quantity);

            _averageItemsPerOrder =
                _todayOrderCount > 0
                    ? (decimal)totalItems / _todayOrderCount
                    : 0m;

            _activeOrderCount =
                await db.Orders.CountAsync(order =>
                    order.Status != OrderStatus.Completed &&
                    order.Status != OrderStatus.Cancelled);

            var pizzaSales =
                todayOrders
                    .SelectMany(order => order.Items)
                    .GroupBy(item => item.PizzaName)
                    .Select(group => new
                    {
                        Name = group.Key,
                        Quantity = group.Sum(item => item.Quantity)
                    })
                    .OrderByDescending(item => item.Quantity)
                    .ThenBy(item => item.Name)
                    .ToList();

            if (pizzaSales.Count > 0)
            {
                var topQuantity =
                    pizzaSales[0].Quantity;

                var topPizzas =
                    pizzaSales
                        .Where(item => item.Quantity == topQuantity)
                        .ToList();

                if (topPizzas.Count == 1)
                {
                    _topPizzaName =
                        topPizzas[0].Name;

                    _topPizzaDetail =
                        $"{topQuantity} sold today";
                }
                else
                {
                    _topPizzaName =
                        $"{topPizzas.Count}-way tie";

                    _topPizzaDetail =
                        $"{topQuantity} each today";
                }
            }
            else
            {
                _topPizzaName = "—";
                _topPizzaDetail = "No sales today";
            }
        }
        catch
        {
            _salesError =
                "We couldn't load the sales summary. Please try again.";
        }
        finally
        {
            _isLoadingSales = false;
        }
    }

