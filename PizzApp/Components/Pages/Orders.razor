@page "/orders"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using PizzApp.Data
@using PizzApp.Models
@using PizzApp.Services

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<PizzAppDbContext> DbFactory
@inject CartService CartService
@inject NavigationManager Navigation

@attribute [Authorize(Roles = "Customer,Administrator")]

@implements IAsyncDisposable

<PageTitle>Order History & Tracking - PizzApp</PageTitle>

<div class="container-xl py-4 py-md-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h1 class="h2 fw-bold mb-1">Order History & Tracking</h1>

            <p class="text-muted mb-0">
                Follow your active pizza order in real-time or view your past orders.
            </p>
        </div>

        <div>
            <NavLink href="menu" class="btn btn-pizzapp-primary">
                <i class="bi bi-plus-circle me-1"></i>
                Order New Pizza
            </NavLink>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center">
            <div class="spinner-border text-danger mx-auto mb-3" role="status"></div>

            <p class="text-muted mb-0">
                Loading your orders...
            </p>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4 rounded-3" role="alert">
            <i class="bi bi-check-circle-fill flex-shrink-0 fs-5"></i>
            <div>@_successMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => _successMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4 rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 fs-5"></i>
            <div>@_errorMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => _errorMessage = string.Empty"></button>
        </div>
    }
    else if (_orders.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center">
            <i class="bi bi-receipt display-4 text-muted mb-3"></i>

            <h2 class="h4 fw-bold">
                No orders yet
            </h2>

            <p class="text-muted mb-4">
                Your orders will appear here after you place them.
            </p>

            <div>
                <NavLink href="menu" class="btn btn-pizzapp-primary">
                    <i class="bi bi-pizza me-1"></i>
                    Order a Pizza
                </NavLink>
            </div>
        </div>
    }
    else
    {
        @foreach (var activeOrder in ActiveOrders)
        {
            <!-- Active Order Live Tracker -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-5">

                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">

                    <div>
                        <span class="badge bg-danger-subtle text-danger px-3 py-1 rounded-pill fw-semibold mb-1">
                            <i class="bi bi-broadcast me-1"></i>
                            Live Tracking
                        </span>

                        <h3 class="h5 fw-bold mb-0">
                            Order #@activeOrder.OrderNumber
                        </h3>
                    </div>

                    <div class="text-sm-end">
                        <span class="text-muted small d-block">
                            @(activeOrder.FulfillmentType == FulfillmentType.Delivery
                                ? "Estimated Delivery:"
                                : "Estimated Pickup:")
                        </span>

                        <span class="fw-bold text-dark fs-5">
                            @(activeOrder.FulfillmentType == FulfillmentType.Delivery
                                ? "25 – 35 mins"
                                : "15 – 25 mins")
                        </span>
                    </div>

                </div>

                <!-- Progress Tracker -->
                <div class="position-relative my-4 px-2">

                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-danger"
                             role="progressbar"
                             style="width: @(GetProgressPercent(activeOrder))%;"
                             aria-valuenow="@GetProgressPercent(activeOrder)"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>
                    </div>

                    <div class="d-flex justify-content-between position-relative"
                         style="margin-top: -19px;">

                        @for (var step = 1; step <= 4; step++)
                        {
                            var stepNumber = step;

                            <div class="text-center" style="width: 110px;">

                                <div class="@GetStepCircleClass(activeOrder, stepNumber)"
                                     style="width: 32px; height: 32px;">

                                    <i class="@GetStepIcon(activeOrder, stepNumber)"></i>
                                </div>

                                <span class="@GetStepLabelClass(activeOrder, stepNumber)">
                                    @GetStepLabel(activeOrder, stepNumber)
                                </span>

                            </div>
                        }

                    </div>

                </div>

                <div class="bg-light p-3 rounded-3 mt-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 small">

                    <div>
                        <strong>Items:</strong>
                        @GetItemsSummary(activeOrder)
                    </div>

                    <div>
                        @if (activeOrder.FulfillmentType == FulfillmentType.Delivery)
                        {
                            <strong>Delivering to:</strong>
                            <span>
                                @(activeOrder.DeliveryAddress ?? "Address unavailable")
                            </span>
                        }
                        else
                        {
                            <strong>Pickup at:</strong>
                            <span>PizzApp Store #1</span>
                        }
                    </div>

                </div>

                @if (activeOrder.Status == OrderStatus.Received)
                {
                    <div class="mt-4 pt-3 border-top d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                        <span class="text-muted small">
                            <i class="bi bi-info-circle text-primary me-1"></i>
                            Your order has just been received and is eligible for cancellation before baking begins.
                        </span>

                        <button type="button"
                                class="btn btn-outline-danger btn-sm px-3"
                                @onclick="() => OpenCancelModal(activeOrder)">
                            <i class="bi bi-x-circle me-1"></i> Cancel Order
                        </button>
                    </div>
                }
                else
                {
                    <div class="mt-4 pt-3 border-top d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 text-muted small">
                        <span>
                            <i class="bi bi-lock-fill me-1 text-secondary"></i>
                            @(activeOrder.Status == OrderStatus.Baking
                                ? "Your pizza is currently baking in the oven and can no longer be cancelled."
                                : "Your order is being prepared for fulfillment and can no longer be cancelled.")
                        </span>

                        <span class="badge bg-light text-muted border py-2 px-3 rounded-pill">
                            Cancellation Window Closed
                        </span>
                    </div>
                }

            </div>
        }

        <!-- Previous Orders -->
        <h4 class="h5 fw-bold mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-clock-history text-danger"></i>
            Past Orders
        </h4>

        @if (!PastOrders.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <p class="text-muted mb-0">
                    No previous orders yet.
                </p>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">

                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Order ID</th>
                                <th>Date</th>
                                <th>Items</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var order in PastOrders)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">
                                        #@order.OrderNumber
                                    </td>

                                    <td class="text-muted">
                                        @order.PlacedAt.ToString("MMM d, yyyy")
                                    </td>

                                    <td>
                                        @GetItemsSummary(order)
                                    </td>

                                    <td class="fw-semibold">
                                        $@order.Total.ToString("0.00")
                                    </td>

                                    <td>
                                        <span class="@GetStatusBadgeClass(order)">
                                            @GetStatusLabel(order)
                                        </span>
                                    </td>

                                    <td class="text-end pe-4">

                                        <div class="d-inline-flex gap-2">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    @onclick="() => ToggleReceipt(order.Id)">
                                                @(_expandedOrderId == order.Id
                                                    ? "Hide Receipt"
                                                    : "View Receipt")
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-pizzapp-secondary fw-semibold"
                                                    @onclick="() => PrepareReorderAsync(order)"
                                                    disabled="@_isLoadingReorder"
                                                    title="Replicate this order using current pricing and menu availability">
                                                <i class="bi bi-arrow-repeat me-1"></i> Order Again
                                            </button>
                                        </div>

                                    </td>
                                </tr>

                                @if (_expandedOrderId == order.Id)
                                {
                                    <tr class="table-light">

                                        <td colspan="6" class="px-4 py-3">

                                            <div class="row g-3">

                                                <div class="col-12 col-md-6">

                                                    <div class="fw-semibold mb-2">
                                                        Order Items
                                                    </div>

                                                    @foreach (var item in order.Items)
                                                    {
                                                        <div class="small mb-2">

                                                            <strong>
                                                                @item.Quantity×
                                                                @item.Size
                                                                @GetPizzaName(item)
                                                            </strong>

                                                            @if (item.IsCustom)
                                                            {
                                                                <div class="text-muted">
                                                                    @item.Crust,
                                                                    @item.Sauce,
                                                                    @item.Cheese
                                                                </div>

                                                                @if (!string.IsNullOrWhiteSpace(item.Toppings))
                                                                {
                                                                    <div class="text-muted">
                                                                        Toppings:
                                                                        @item.Toppings
                                                                    </div>
                                                                }
                                                            }

                                                            <div>
                                                                $@item.TotalPrice.ToString("0.00")
                                                            </div>

                                                        </div>
                                                    }

                                                </div>

                                                <div class="col-12 col-md-6">

                                                    <div class="fw-semibold mb-2">
                                                        Order Details
                                                    </div>

                                                    <div class="small">
                                                        <div>
                                                            <strong>Type:</strong>
                                                            @order.FulfillmentType
                                                        </div>

                                                        <div>
                                                            <strong>Status:</strong>
                                                            @GetStatusLabel(order)
                                                        </div>

                                                        @if (order.FulfillmentType == FulfillmentType.Delivery)
                                                        {
                                                            <div>
                                                                <strong>Delivering to:</strong>
                                                                @(order.DeliveryAddress ?? "Address unavailable")
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div>
                                                                <strong>Pickup at:</strong>
                                                                PizzApp Store #1
                                                            </div>
                                                        }

                                                        <hr class="my-2" />

                                                        <div>
                                                            <strong>Subtotal:</strong>
                                                            $@order.Subtotal.ToString("0.00")
                                                        </div>

                                                        <div>
                                                            <strong>Tax:</strong>
                                                            $@order.Tax.ToString("0.00")
                                                        </div>

                                                        <div>
                                                            <strong>Delivery Fee:</strong>
                                                            $@order.DeliveryFee.ToString("0.00")
                                                        </div>

                                                        <div class="fw-bold mt-1">
                                                            Total:
                                                            $@order.Total.ToString("0.00")
                                                        </div>

                                                        <div class="mt-3">
                                                            <button type="button"
                                                                    class="btn btn-sm btn-pizzapp-secondary fw-semibold w-100"
                                                                    @onclick="() => PrepareReorderAsync(order)"
                                                                    disabled="@_isLoadingReorder">
                                                                <i class="bi bi-arrow-repeat me-1"></i> Order Again
                                                            </button>
                                                        </div>

                                                    </div>

                                                </div>

                                            </div>

                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }
    }

    <!-- CANCELLATION CONFIRMATION MODAL -->
    @if (_orderToCancel != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1055;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow rounded-4 p-2">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold text-danger d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            Cancel Order #@_orderToCancel.OrderNumber
                        </h5>
                        <button type="button" class="btn-close" @onclick="CloseCancelModal" disabled="@_isProcessingCancel"></button>
                    </div>
                    <div class="modal-body py-3">
                        <p class="text-dark mb-2">
                            Are you sure you want to cancel this order? It is currently in the <strong>Received</strong> stage and is eligible for cancellation.
                        </p>
                        <p class="text-muted small mb-3">Once cancelled, this order cannot be restored.</p>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold text-dark">Reason for cancellation (optional):</label>
                            <select class="form-select" @bind="_cancellationReason">
                                <option value="Changed my mind">Changed my mind</option>
                                <option value="Ordered by mistake">Ordered by mistake</option>
                                <option value="Delivery time too long">Delivery time too long</option>
                                <option value="Need to change items">Need to change items</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseCancelModal" disabled="@_isProcessingCancel">
                            Keep Order
                        </button>
                        <button type="button" class="btn btn-danger" @onclick="ConfirmCancelOrderAsync" disabled="@_isProcessingCancel">
                            @if (_isProcessingCancel)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Cancelling...</span>
                            }
                            else
                            {
                                <i class="bi bi-x-circle me-1"></i>
                                <span>Yes, Cancel Order</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ORDER AGAIN / REPLICATE ORDER MODAL -->
    @if (_reorderPreview != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1055;">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 shadow rounded-4 p-2">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-arrow-repeat text-danger"></i>
                            Order Again &bull; Replicate Order #@_reorderPreview.SourceOrder.OrderNumber
                        </h5>
                        <button type="button" class="btn-close" @onclick="CloseReorderModal" disabled="@_isProcessingReorder"></button>
                    </div>
                    <div class="modal-body py-3">
                        <p class="text-muted small mb-3">
                            Replicating your previous order using <strong>current database pricing and menu availability</strong>.
                        </p>

                        @if (!_reorderPreview.IsAllAvailable)
                        {
                            <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 mb-3 rounded-3 small">
                                <i class="bi bi-exclamation-triangle-fill flex-shrink-0 fs-5"></i>
                                <div>
                                    <strong>Some items are currently unavailable:</strong>
                                    <ul class="mb-0 ps-3 mt-1">
                                        @foreach (var unavail in _reorderPreview.UnavailableReasons)
                                        {
                                            <li>@unavail</li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success d-flex align-items-center gap-2 py-2 px-3 mb-3 rounded-3 small">
                                <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                                <div>All pizzas and ingredients are in stock and available at today's menu prices.</div>
                            </div>
                        }

                        <!-- Items list with current pricing -->
                        <div class="table-responsive mb-3">
                            <table class="table align-middle table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Item</th>
                                        <th>Size / Details</th>
                                        <th class="text-center">Qty</th>
                                        <th class="text-end">Current Price</th>
                                        <th class="text-end">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in _reorderPreview.Items)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@item.PizzaName</td>
                                            <td class="small text-muted">
                                                @item.Size
                                                @if (item.IsCustom && !string.IsNullOrWhiteSpace(item.Toppings))
                                                {
                                                    <div>Toppings: @item.Toppings</div>
                                                }
                                            </td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-end fw-semibold">
                                                $@item.TotalPrice.ToString("0.00")
                                                @if (item.UnitPriceChanged)
                                                {
                                                    <div class="text-muted" style="font-size: 0.72rem;">
                                                        (was $@item.OldUnitPrice.ToString("0.00"))
                                                    </div>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (item.IsAvailable)
                                                {
                                                    <span class="badge bg-success-subtle text-success">Available</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger">Unavailable</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pricing summary -->
                        <div class="bg-light p-3 rounded-3 small">
                            <div class="d-flex justify-content-between mb-1">
                                <span>Subtotal:</span>
                                <span class="fw-semibold">$@_reorderPreview.Subtotal.ToString("0.00")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span>
                                    Sales Tax (@CartService.SalesTaxPercent.ToString("0.##")%):
                                </span>
                                <span class="fw-semibold">$@_reorderPreview.Tax.ToString("0.00")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span>Fulfillment:</span>
                                <span class="fw-semibold">
                                    @_reorderPreview.SourceOrder.FulfillmentType
                                    (@(_reorderPreview.DeliveryFee > 0 ? $"${_reorderPreview.DeliveryFee:0.00}" : "Free"))
                                </span>
                            </div>
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between fs-6 fw-bold">
                                <span>New Total:</span>
                                <span class="text-danger">$@_reorderPreview.Total.ToString("0.00")</span>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 d-flex justify-content-between">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseReorderModal" disabled="@_isProcessingReorder">
                            Cancel
                        </button>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-danger" @onclick="ReorderToCart" disabled="@(!_reorderPreview.IsAllAvailable || _isProcessingReorder)">
                                <i class="bi bi-cart-plus me-1"></i> Add to Cart & Edit
                            </button>
                            <button type="button" class="btn btn-pizzapp-primary" @onclick="ConfirmReorderDirectlyAsync" disabled="@(!_reorderPreview.IsAllAvailable || _isProcessingReorder)">
                                @if (_isProcessingReorder)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Placing Order...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle me-1"></i>
                                    <span>Reorder Now ($@_reorderPreview.Total.ToString("0.00"))</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private string? _customerId;

    private List<Order> _orders = new();

    private bool _isLoading = true;

    private string _errorMessage = string.Empty;

    private string _successMessage = string.Empty;

    private int? _expandedOrderId;

    private Order? _orderToCancel;
    private string _cancellationReason = "Changed my mind";
    private bool _isProcessingCancel;

    private ReorderPreviewModel? _reorderPreview;
    private bool _isLoadingReorder;
    private bool _isProcessingReorder;

    private CancellationTokenSource? _refreshCancellation;

    private Task? _refreshTask;

    private IEnumerable<Order> ActiveOrders =>
    _orders.Where(order =>
        order.Status != OrderStatus.Completed &&
        order.Status != OrderStatus.Cancelled);

    private IEnumerable<Order> PastOrders =>
        _orders.Where(order =>
            order.Status == OrderStatus.Completed ||
            order.Status == OrderStatus.Cancelled);

    protected override async Task OnInitializedAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        _customerId = authenticationState.User
            .FindFirst(ClaimTypes.NameIdentifier)?
            .Value;

        if (string.IsNullOrWhiteSpace(_customerId))
        {
            _errorMessage =
                "Your account could not be identified. Please sign in again.";

            _isLoading = false;

            return;
        }

        await LoadOrdersAsync();

        _refreshCancellation = new CancellationTokenSource();

        _refreshTask =
            RefreshOrdersPeriodicallyAsync(
                _refreshCancellation.Token);
    }

    private async Task LoadOrdersAsync(
        CancellationToken cancellationToken = default)
    {
        if (string.IsNullOrWhiteSpace(_customerId))
        {
            return;
        }

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync(cancellationToken);

            _orders = await db.Orders
                .AsNoTracking()
                .Include(order => order.Items)
                .Where(order => order.CustomerId == _customerId)
                .OrderByDescending(order => order.PlacedAt)
                .ToListAsync(cancellationToken);

            _errorMessage = string.Empty;
        }
        catch (OperationCanceledException)
        {
            // Normal when the page is closed.
        }
        catch
        {
            _errorMessage =
                "We couldn't load your orders. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshOrdersPeriodicallyAsync(
        CancellationToken cancellationToken)
    {
        using var timer =
            new PeriodicTimer(TimeSpan.FromSeconds(10));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await LoadOrdersAsync(cancellationToken);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when navigating away from this page.
        }
    }

    private void ToggleReceipt(int orderId)
    {
        _expandedOrderId =
            _expandedOrderId == orderId
                ? null
                : orderId;
    }

    private static string GetItemsSummary(Order order)
    {
        return string.Join(
            ", ",
            order.Items.Select(item =>
                $"{item.Quantity}x {item.Size} {GetPizzaName(item)}"));
    }

    private static string GetPizzaName(OrderItem item)
    {
        return item.PizzaName.EndsWith(
            "Pizza",
            StringComparison.OrdinalIgnoreCase)
                ? item.PizzaName
                : $"{item.PizzaName} Pizza";
    }

    private static int GetCurrentStep(Order order)
    {
        return order.Status switch
        {
            OrderStatus.Received => 1,

            OrderStatus.Baking => 2,

            OrderStatus.Ready =>
                order.FulfillmentType == FulfillmentType.Pickup
                    ? 3
                    : 2,

            OrderStatus.OutForDelivery => 3,

            OrderStatus.Completed => 4,

            _ => 1
        };
    }

    private static int GetProgressPercent(Order order)
    {
        return GetCurrentStep(order) switch
        {
            1 => 0,
            2 => 33,
            3 => 66,
            4 => 100,
            _ => 0
        };
    }

    private static string GetStepLabel(
        Order order,
        int step)
    {
        return step switch
        {
            1 => "Received",

            2 => "Baking",

            3 => order.FulfillmentType == FulfillmentType.Pickup
                ? "Ready for Pickup"
                : "On the Way",

            4 => order.FulfillmentType == FulfillmentType.Pickup
                ? "Picked Up"
                : "Delivered",

            _ => string.Empty
        };
    }

    private static string GetStepIcon(
        Order order,
        int step)
    {
        var currentStep = GetCurrentStep(order);

        if (step < currentStep)
        {
            return "bi bi-check-lg";
        }

        return step switch
        {
            1 => "bi bi-check-lg",

            2 => "bi bi-fire",

            3 => order.FulfillmentType == FulfillmentType.Pickup
                ? "bi bi-shop"
                : "bi bi-bicycle",

            4 => order.FulfillmentType == FulfillmentType.Pickup
                ? "bi bi-bag-check"
                : "bi bi-house",

            _ => "bi bi-circle"
        };
    }

    private static string GetStepCircleClass(
        Order order,
        int step)
    {
        var currentStep = GetCurrentStep(order);

        var colorClass =
            step <= currentStep
                ? "bg-danger text-white shadow-sm"
                : "bg-light border text-muted";

        return
            $"rounded-circle {colorClass} mx-auto " +
            "d-flex align-items-center justify-content-center";
    }

    private static string GetStepLabelClass(
        Order order,
        int step)
    {
        var currentStep = GetCurrentStep(order);

        if (step == currentStep)
        {
            return "small fw-bold mt-2 d-block text-danger";
        }

        if (step < currentStep)
        {
            return "small fw-semibold mt-2 d-block text-dark";
        }

        return "small fw-normal mt-2 d-block text-muted";
    }

    private static string GetStatusLabel(Order order)
    {
        return order.Status switch
        {
            OrderStatus.Received => "Received",

            OrderStatus.Baking => "Baking",

            OrderStatus.Ready =>
                order.FulfillmentType == FulfillmentType.Pickup
                    ? "Ready for Pickup"
                    : "Ready",

            OrderStatus.OutForDelivery => "On the Way",

            OrderStatus.Completed =>
                order.FulfillmentType == FulfillmentType.Pickup
                    ? "Picked Up"
                    : "Delivered",

            OrderStatus.Cancelled => "Cancelled",

            _ => order.Status.ToString()
        };
    }

    private static string GetStatusBadgeClass(Order order)
    {
        return order.Status switch
        {
            OrderStatus.Completed =>
                "badge bg-success-subtle text-success rounded-pill px-3 py-1",

            OrderStatus.Cancelled =>
                "badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1",

            _ =>
                "badge bg-danger-subtle text-danger rounded-pill px-3 py-1"
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (_refreshCancellation is not null)
        {
            await _refreshCancellation.CancelAsync();
        }

        if (_refreshTask is not null)
        {
            try
            {
                await _refreshTask;
            }
            catch (OperationCanceledException)
            {
                // Normal shutdown.
            }
        }

        _refreshCancellation?.Dispose();
    }

    private void OpenCancelModal(Order order)
    {
        _orderToCancel = order;
        _cancellationReason = "Changed my mind";
    }

    private void CloseCancelModal()
    {
        if (_isProcessingCancel)
        {
            return;
        }

        _orderToCancel = null;
    }

    private async Task ConfirmCancelOrderAsync()
    {
        if (_orderToCancel == null || _isProcessingCancel)
        {
            return;
        }

        _isProcessingCancel = true;
        _errorMessage = string.Empty;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var dbOrder = await db.Orders.FirstOrDefaultAsync(o => o.Id == _orderToCancel.Id);

            if (dbOrder == null)
            {
                _errorMessage = "That order could not be found.";
            }
            else if (dbOrder.Status != OrderStatus.Received)
            {
                _errorMessage = $"Order #{dbOrder.OrderNumber} can no longer be cancelled because it is already in the '{GetStatusLabel(dbOrder)}' stage.";
            }
            else
            {
                dbOrder.Status = OrderStatus.Cancelled;
                await db.SaveChangesAsync();

                _successMessage = $"Order #{dbOrder.OrderNumber} has been successfully cancelled.";
                _orderToCancel = null;
                await LoadOrdersAsync();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            _errorMessage = "We couldn't cancel your order. Please try again.";
        }
        finally
        {
            _isProcessingCancel = false;
        }
    }

    private void CloseReorderModal()
    {
        if (_isProcessingReorder)
        {
            return;
        }

        _reorderPreview = null;
    }

    private async Task PrepareReorderAsync(Order sourceOrder)
    {
        _errorMessage = string.Empty;
        _successMessage = string.Empty;
        _isLoadingReorder = true;

        try
        {
            await CartService.LoadStoreSettingsAsync();
            await using var db = await DbFactory.CreateDbContextAsync();
            var specialtyPizzas = await db.SpecialtyPizzas.AsNoTracking().ToListAsync();
            var toppings = await db.Toppings.AsNoTracking().ToListAsync();

            var preview = new ReorderPreviewModel
            {
                SourceOrder = sourceOrder
            };

            foreach (var item in sourceOrder.Items)
            {
                var reorderItem = new ReorderItemModel
                {
                    SpecialtyPizzaId = item.SpecialtyPizzaId,
                    IsCustom = item.IsCustom,
                    PizzaName = item.PizzaName,
                    Size = item.Size,
                    Crust = item.Crust,
                    Sauce = item.Sauce,
                    Cheese = item.Cheese,
                    Toppings = item.Toppings ?? string.Empty,
                    Quantity = item.Quantity,
                    OldUnitPrice = item.UnitPrice
                };

                if (!item.IsCustom)
                {
                    var cleanName = item.PizzaName.Replace(" Pizza", "", StringComparison.OrdinalIgnoreCase).Trim();
                    var specPizza = specialtyPizzas.FirstOrDefault(p =>
                        (item.SpecialtyPizzaId.HasValue && p.Id == item.SpecialtyPizzaId.Value) ||
                        string.Equals(p.Name, cleanName, StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(p.Name, item.PizzaName, StringComparison.OrdinalIgnoreCase));

                    if (specPizza == null)
                    {
                        reorderItem.IsAvailable = false;
                        reorderItem.UnavailableReason = $"'{item.PizzaName}' is no longer on the menu.";
                        reorderItem.UnitPrice = item.UnitPrice;
                        reorderItem.BasePrice = item.UnitPrice;
                        reorderItem.ImagePath = "images/pizza-hero.png";
                    }
                    else if (!specPizza.IsAvailable)
                    {
                        reorderItem.IsAvailable = false;
                        reorderItem.UnavailableReason = $"'{specPizza.Name}' is currently sold out.";
                        reorderItem.UnitPrice = specPizza.SmallPrice;
                        reorderItem.BasePrice = specPizza.SmallPrice;
                        reorderItem.ImagePath = specPizza.ImagePath;
                    }
                    else
                    {
                        reorderItem.IsAvailable = true;
                        reorderItem.ImagePath = specPizza.ImagePath;
                        reorderItem.SpecialtyPizzaId = specPizza.Id;
                        reorderItem.PizzaName = specPizza.Name;

                        decimal currentPrice = item.Size switch
                        {
                            "Small" => specPizza.SmallPrice,
                            "Medium" => specPizza.MediumPrice,
                            "Large" => specPizza.LargePrice,
                            "X-Large" or "Extra Large" or "XL" => specPizza.XLargePrice,
                            _ => specPizza.SmallPrice
                        };

                        reorderItem.BasePrice = currentPrice;
                        reorderItem.UnitPrice = currentPrice;
                    }
                }
                else
                {
                    decimal basePrice = PizzaRules.BasePriceFor(item.Size);
                    reorderItem.BasePrice = basePrice;
                    reorderItem.ImagePath = "/images/builder/base-cheese.png";

                    decimal toppingsTotal = 0m;
                    var toppingNames = (item.Toppings ?? string.Empty)
                        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

                    foreach (var toppingName in toppingNames)
                    {
                        var toppingEntity = toppings.FirstOrDefault(t =>
                            string.Equals(t.Name, toppingName, StringComparison.OrdinalIgnoreCase));

                        if (toppingEntity == null)
                        {
                            reorderItem.IsAvailable = false;
                            reorderItem.UnavailableReason = $"Topping '{toppingName}' is no longer offered.";
                        }
                        else if (!toppingEntity.IsAvailable)
                        {
                            reorderItem.IsAvailable = false;
                            reorderItem.UnavailableReason = $"Topping '{toppingEntity.Name}' is currently out of stock.";
                        }
                        else
                        {
                            toppingsTotal += toppingEntity.Price;
                            reorderItem.ToppingEntities.Add(toppingEntity);
                        }
                    }

                    reorderItem.UnitPrice = basePrice + toppingsTotal;
                }

                preview.Items.Add(reorderItem);
            }

            preview.Subtotal = preview.Items.Sum(i => i.TotalPrice);
            preview.Tax =
                Math.Round(
                    preview.Subtotal * CartService.TaxRate,
                    2);
            preview.DeliveryFee = sourceOrder.FulfillmentType == FulfillmentType.Delivery
                ? CartService.DeliveryFee
                : 0m;
            preview.Total = preview.Subtotal + preview.Tax + preview.DeliveryFee;

            _reorderPreview = preview;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            _errorMessage = "We couldn't check the current menu pricing. Please try again.";
        }
        finally
        {
            _isLoadingReorder = false;
        }
    }

    private async Task ConfirmReorderDirectlyAsync()
    {
        if (_reorderPreview == null || !_reorderPreview.IsAllAvailable || _isProcessingReorder)
        {
            return;
        }

        _isProcessingReorder = true;
        _errorMessage = string.Empty;

        try
        {
            var source = _reorderPreview.SourceOrder;

            var newOrder = new Order
            {
                CustomerId = _customerId!,
                CustomerName = source.CustomerName,
                CustomerEmail = source.CustomerEmail,
                FulfillmentType = source.FulfillmentType,
                DeliveryAddress = source.DeliveryAddress,
                PlacedAt = DateTimeOffset.UtcNow,
                Status = OrderStatus.Received,
                Subtotal = _reorderPreview.Subtotal,
                Tax = _reorderPreview.Tax,
                DeliveryFee = _reorderPreview.DeliveryFee,
                Total = _reorderPreview.Total,
                Items = _reorderPreview.Items.Select(item => new OrderItem
                {
                    SpecialtyPizzaId = !item.IsCustom ? item.SpecialtyPizzaId : null,
                    IsCustom = item.IsCustom,
                    PizzaName = item.PizzaName,
                    Size = item.Size,
                    Crust = item.Crust,
                    Sauce = item.Sauce,
                    Cheese = item.Cheese,
                    Toppings = item.Toppings,
                    Quantity = item.Quantity,
                    UnitPrice = item.UnitPrice,
                    TotalPrice = item.TotalPrice
                }).ToList()
            };

            await using var db = await DbFactory.CreateDbContextAsync();
            db.Orders.Add(newOrder);
            await db.SaveChangesAsync();

            _successMessage = $"🎉 Order #{newOrder.OrderNumber} placed! Your previous order has been replicated with current database pricing (${newOrder.Total:0.00}). It is now in preparation.";
            _reorderPreview = null;
            await LoadOrdersAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            _errorMessage = "We couldn't place your order again. Please try again.";
        }
        finally
        {
            _isProcessingReorder = false;
        }
    }

    private void ReorderToCart()
    {
        if (_reorderPreview == null || !_reorderPreview.IsAllAvailable)
        {
            return;
        }

        foreach (var item in _reorderPreview.Items)
        {
            var cartItem = new CartItem
            {
                IsCustom = item.IsCustom,
                PizzaId = item.SpecialtyPizzaId ?? 0,
                PizzaName = item.PizzaName,
                ImagePath = item.ImagePath,
                Size = item.Size,
                Crust = item.Crust,
                Sauce = item.Sauce,
                Cheese = item.Cheese,
                BasePrice = item.BasePrice,
                Quantity = item.Quantity,
                Toppings = item.ToppingEntities.Select(t => new Topping
                {
                    Id = t.Id,
                    Name = t.Name,
                    ImagePath = t.ImagePath,
                    Price = t.Price,
                    IsAvailable = t.IsAvailable
                }).ToList()
            };

            CartService.AddItem(cartItem);
        }

        _reorderPreview = null;
        Navigation.NavigateTo("/cart");
    }

    private class ReorderPreviewModel
    {
        public Order SourceOrder { get; set; } = null!;
        public List<ReorderItemModel> Items { get; set; } = new();
        public decimal Subtotal { get; set; }
        public decimal Tax { get; set; }
        public decimal DeliveryFee { get; set; }
        public decimal Total { get; set; }
        public bool IsAllAvailable => Items.All(i => i.IsAvailable);
        public List<string> UnavailableReasons => Items
            .Where(i => !i.IsAvailable && !string.IsNullOrWhiteSpace(i.UnavailableReason))
            .Select(i => i.UnavailableReason!)
            .ToList();
    }

    private class ReorderItemModel
    {
        public int? SpecialtyPizzaId { get; set; }
        public bool IsCustom { get; set; }
        public string PizzaName { get; set; } = string.Empty;
        public string ImagePath { get; set; } = string.Empty;
        public string Size { get; set; } = "Medium";
        public string Crust { get; set; } = "Hand Tossed";
        public string Sauce { get; set; } = "Marinara";
        public string Cheese { get; set; } = "Mozzarella";
        public string Toppings { get; set; } = string.Empty;
        public List<Topping> ToppingEntities { get; set; } = new();
        public int Quantity { get; set; } = 1;
        public decimal BasePrice { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal TotalPrice => UnitPrice * Quantity;
        public decimal OldUnitPrice { get; set; }
        public bool UnitPriceChanged => Math.Abs(UnitPrice - OldUnitPrice) > 0.01m;
        public bool IsAvailable { get; set; } = true;
        public string? UnavailableReason { get; set; }
    }
}