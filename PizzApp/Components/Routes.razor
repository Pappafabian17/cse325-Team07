<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <!-- Route authorization complements role-aware navigation and protects direct URL access. -->
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <div class="container py-5 text-center">
                    <div class="card border-0 shadow-sm rounded-4 p-5 mx-auto bg-white" style="max-width: 520px;">
                        <div class="mb-3 text-danger">
                            <i class="bi bi-shield-lock-fill" style="font-size: 3.5rem;"></i>
                        </div>
                        <h2 class="h3 fw-bold mb-2 text-dark">Access Denied</h2>
                        <p class="text-muted mb-4">
                            You do not have permission to view this page. Please sign in with an account that has the required role (Customer, Staff, or Administrator).
                        </p>
                        <div class="d-flex justify-content-center gap-2">
                            <a href="" class="btn btn-outline-secondary px-3">Return Home</a>
                            <a href="login" class="btn btn-danger px-3">Sign In</a>
                        </div>
                    </div>
                </div>
            </NotAuthorized>
            <Authorizing>
                <div class="container py-5 text-center text-muted">
                    <div class="spinner-border text-danger mb-2" role="status"></div>
                    <p class="small">Verifying authorization...</p>
                </div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
